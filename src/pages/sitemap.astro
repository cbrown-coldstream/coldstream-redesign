  }
  /* The board is a working surface — printing it is a legitimate way to take it into a meeting. */
  @media print{
    body:has(.rb){background:#fff}
    .rb{color:#000;background:#fff}
    .rb-top{position:static}.rb-filters,.rb-tools,.rb-open{display:none}
    .rb-detail{display:block!important}
    .rb-page{break-inside:avoid;border:1px solid #999}
  }
</style>
