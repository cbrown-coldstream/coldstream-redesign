  .rb-req-body{margin:6px 0 0;font-size:.84rem;color:var(--dim);line-height:1.5;white-space:pre-wrap}
  .rb-req-foot{margin-top:8px}
  .rb-req-state{font:inherit;font-size:.76rem;background:#0e141c;color:var(--ink);
