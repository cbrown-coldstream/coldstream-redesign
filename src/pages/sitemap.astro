---
// /sitemap/ — THE TEAM REVIEW BOARD. Not a public sitemap any more.
//
// WHAT CHANGED AND WHY IT MATTERS. This started as a human-readable sitemap for visitors. It is now
// the page the team walks the build from: every page listed, a checkbox per page and per section, a
// status, and a notes field for what needs to change in copy or design. That is a different kind of
// page with different rules, so three things moved with it:
//
//   1. IT IS NOINDEX. A checklist of unfinished work, with internal notes in it, is not something to
//      hand Google. See data/sitemap.js, where it is registered `index: false`.
//   2. IT IS OUT OF sitemap.xml, for the same reason.
//   3. IT DOES NOT FOLLOW THE WEB DESIGN SYSTEM, on instruction. It is a tool: dense, high-contrast,
//      monospace where that helps scanning. It deliberately does not look like the marketing site,
//      because looking like the marketing site is how an internal page ends up shown to a customer.
//
// THE LINKS IN THE HEADER AND FOOTER ARE STILL THERE. They were added on request and the team needs
// to reach this quickly. ⚠ THEY MUST COME OUT BEFORE CUTOVER — a nav link to an internal review
// board on the live site is the kind of thing nobody notices until a customer clicks it.
//
// NOTES AND TICKS LIVE IN localStorage, WHICH MEANS THEY ARE PER-BROWSER. There is no server on this
// site to save them to — it is static output on a host with no runtime. So the board also has
// Export and Import: one JSON file, passed around or dropped in a shared drive, is how two people
// end up looking at the same review. That is a real limitation and it is stated on the page rather
// than discovered when someone loses an afternoon of notes.
import BaseLayout from "../layouts/BaseLayout.astro";
import { NATIONAL, MARKETS, MARKET_LIST } from "../data/markets.js";
import { INDEXABLE, NOINDEXED } from "../data/sitemap.js";
import { REVIEW_SECTIONS, laneFor, REVIEW_STATES } from "../data/review-sections.js";
import { foldsInto, summary, REASONS } from "../data/consolidation.js";
import { REVIEW_DB } from "../data/review-db.js";

const market = NATIONAL;
const marketSlugs = Object.keys(MARKETS);

// EVERY page, including the ones waiting on data — this is a build checklist, so a page that is
// not finished is exactly the page the team most needs in front of them. The public version of this
// list hid them; this one flags them instead.
const all = [
  ...INDEXABLE().map((u) => ({ path: u.path, index: true, why: null })),
  ...NOINDEXED().map((u) => ({ path: u.path, index: false, why: u.why ?? null })),
].filter((u) => u.path !== "/404.html");

const NAMES = {
  "/": "Home", "/free-estimate/": "Free estimate", "/service-areas/": "Service areas",
  "/commercial-roofing/": "Commercial roofing", "/about-us/": "About Coldstream",
  "/financing/": "Financing", "/privacy-policy/": "Privacy policy", "/terms/": "Terms",
  "/blog/": "Advice", "/thank-you/": "Thank you", "/sitemap/": "This board",
};
const titleFor = (p) => NAMES[p] ?? (p.replace(/\/$/, "").split("/").pop() ?? "").replace(/-/g, " ").replace(/^./, (c) => c.toUpperCase());

// Grouped by market, because that is how the work gets divided up.
const groupOf = (p) => {
  const seg = p.replace(/^\//, "").split("/")[0];
  return marketSlugs.includes(seg) ? MARKETS[seg].name : "Company and national";
};
const groups = ["Company and national", ...MARKET_LIST.map((m) => m.name)].map((name) => ({
  name,
  rows: all
    .filter((u) => groupOf(u.path) === name)
    .map((u) => ({ ...u, lane: laneFor(u.path, marketSlugs), title: titleFor(u.path) }))
    .sort((a, b) => a.path.localeCompare(b.path)),
}));

const folds = foldsInto();
const cons = summary();

// LANE LABELS. The board grouped by market, which is how the work divides up, but a reviewer also
// needs to know what KIND of page they are looking at — a sub-service page and a market landing get
// judged against different bars.
const LANE_LABEL = {
  "national-home": "National home",
  "national-service": "National service",
  "market-landing": "Market landing",
  "service-hub": "Service hub",
  "sub-service": "Sub-service",
  location: "Location",
  conversion: "Conversion",
  company: "Company / legal",
};

const totalPages = all.length;
const totalSections = all.reduce((n, u) => n + (REVIEW_SECTIONS[laneFor(u.path, marketSlugs)]?.length ?? 0), 0);
---
<BaseLayout
  title="Page review board — internal | Coldstream Exteriors"
  description="Internal review board. Not for publication."
  canonical="/sitemap/"
  market={market}
  noindex={true}
>
  <div class="rb">
    <header class="rb-top">
      <div class="rb-top-in">
        <div>
          <p class="rb-kicker">Internal — not for customers</p>
          <h1>Page review board</h1>
          <p class="rb-sub">{totalPages} pages · {totalSections} sections. Tick as you go, set a status, leave notes for the team.</p>
        </div>
        <div class="rb-progress" aria-hidden="true">
          <div class="rb-ring"><span id="rbPct">0%</span></div>
          <p><b id="rbDone">0</b> of {totalPages} pages done</p>
        </div>
      </div>

      <div class="rb-bar">
        <div class="rb-filters" role="group" aria-label="Filter pages">
          <button type="button" data-filter="all" aria-pressed="true">All</button>
          <button type="button" data-filter="open" aria-pressed="false">Not done</button>
          <button type="button" data-filter="noted" aria-pressed="false">Has notes</button>
          <button type="button" data-filter="blocked" aria-pressed="false">Blocked</button>
          <button type="button" data-filter="absorbed" aria-pressed="false">Absorbed URLs</button>
          <button type="button" data-filter="requests" aria-pressed="false">Open requests</button>
        </div>
        <div class="rb-tools">
          {/* localStorage is per-browser and there is no server to sync to. Export/import is how
              two people review the same build — see the header note in this file. */}
          <button type="button" id="rbExpand">Expand all</button>
        </div>
      </div>
      {/* SIGNED OUT, THE BOARD IS READ-ONLY STRUCTURE. The page list and the consolidation
          breakdown are baked into the HTML and are useful on their own; every tick, note and edit
          request comes from the database and needs a sign-in. That split is deliberate — an
          anonymous visitor who finds this URL sees what the site is made of, never the team's
          working notes. The database refuses them at the schema boundary regardless. */}
      <div class="rb-auth" id="rbAuth">
        <form id="rbSignIn" class="rb-signin">
          <span class="rb-auth-lead">Sign in to tick, note and request edits</span>
          <input type="email" id="rbEmail" placeholder="you@coldstreamsolar.com" autocomplete="username" required />
          <input type="password" id="rbPass" placeholder="password" autocomplete="current-password" required />
          <button type="submit">Sign in</button>
          <span class="rb-auth-msg" id="rbAuthMsg" role="status" aria-live="polite"></span>
        </form>
        <div class="rb-signed" id="rbSigned" hidden>
          <span>Signed in as <b id="rbWho"></b></span>
          <span class="rb-sync" id="rbSync" role="status" aria-live="polite"></span>
          <button type="button" id="rbSignOut">Sign out</button>
        </div>
      </div>
    </header>

    {/* WHY 68 AND NOT 443. This is the question the whole rebuild answers, and until now it lived
        only in prose in CLAUDE.md. Every number here is computed from the shipped _redirects file
        rather than asserted — see data/consolidation.js. */}
    <section class="rb-why-panel">
      <h2>Why 68 pages and not 443</h2>
      <p class="rb-why-lead">
        The live site is <b>443 URLs</b>. An audit found it was mostly the same page repeated, so
        <b>{cons.total}</b> retired URLs now redirect into <b>{cons.absorbing}</b> of the pages that
        survived. Nothing was deleted without a destination except one.
      </p>
      <div class="rb-why-grid">
        {Object.entries(cons.byReason).sort((a, b) => b[1] - a[1]).map(([k, n]) => (
          <div class="rb-why-card">
            <b>{n}</b>
            <strong>{REASONS[k].label}</strong>
            <span>{REASONS[k].blurb}</span>
          </div>
        ))}
      </div>
      <p class="rb-why-foot">
        Open any page below to see exactly which old URLs fold into it. A page with none is a page
        that is genuinely new rather than a survivor.
      </p>
    </section>

    <main class="rb-body">
      {groups.map((g) => (
        <section class="rb-group">
          <h2>{g.name} <span class="rb-count">{g.rows.length}</span></h2>

          {g.rows.map((row) => {
            const sections = REVIEW_SECTIONS[row.lane] ?? [];
            return (
              <article class="rb-page" data-path={row.path} data-blocked={String(!row.index)} data-folds={String((folds[row.path] ?? []).length)} data-lane={row.lane}>
                <div class="rb-head">
                  <input type="checkbox" class="rb-check" id={`c${row.path}`} aria-label={`Mark ${row.title} reviewed`} />
                  <button type="button" class="rb-toggle" aria-expanded="false">
                    <span class="rb-title">{row.title}</span>
                    <code>{row.path}</code>
                  </button>
                  <span class="rb-lane" title={row.lane}>{LANE_LABEL[row.lane] ?? row.lane}</span>
                  {(folds[row.path] ?? []).length > 0 && (
                    <span class="rb-fold-badge" title={`${(folds[row.path] ?? []).length} retired URLs redirect here`}>
                      ←{(folds[row.path] ?? []).length}
                    </span>
                  )}
                  {!row.index && <span class="rb-flag" title={row.why ?? ""}>noindex</span>}
                  <select class="rb-state" aria-label={`Status for ${row.title}`}>
                    {REVIEW_STATES.map((s) => <option value={s.key}>{s.label}</option>)}
                  </select>
                  <a class="rb-open" href={row.path} target="_blank" rel="noopener">Open ↗</a>
                </div>

                <div class="rb-detail" hidden>
                  {row.why && <p class="rb-why"><b>Waiting on:</b> {row.why}</p>}

                  <div class="rb-cols">
                    <div>
                      <h3>Sections</h3>
                      <ul class="rb-sections">
                        {sections.map((s, i) => (
                          <li>
                            <label>
                              <input type="checkbox" class="rb-scheck" data-sec={i} />
                              <span>{s}</span>
                            </label>
                            <input type="text" class="rb-snote" data-sec={i} placeholder="note…" aria-label={`Note for ${s}`} />
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div>
                      <h3>Absorbed {(folds[row.path] ?? []).length} old URLs</h3>
                      {(folds[row.path] ?? []).length === 0 ? (
                        <p class="rb-none">Nothing redirects here — this page is new, not a survivor.</p>
                      ) : (
                        <ul class="rb-folds">
                          {(folds[row.path] ?? []).map((f) => (
                            <li>
                              <code>{f.from}</code>
                              <span class="rb-reason" title={REASONS[f.reason].blurb}>{REASONS[f.reason].label}</span>
                            </li>
                          ))}
                        </ul>
                      )}

                      <h3>Page notes</h3>
                      <textarea class="rb-note" rows="5" placeholder="Copy, design, anything the team needs to decide…" aria-label={`Notes for ${row.title}`}></textarea>

                      <h3>Edit requests</h3>
                      <div class="rb-reqs" data-reqs></div>
                      <form class="rb-newreq" data-newreq>
                        <select data-kind aria-label="Kind of change">
                          <option value="copy">Copy</option>
                          <option value="design">Design</option>
                          <option value="data">Data</option>
                          <option value="bug">Bug</option>
                          <option value="question">Question</option>
                        </select>
                        <select data-priority aria-label="Priority">
                          <option value="normal">Normal</option>
                          <option value="high">High</option>
                          <option value="low">Low</option>
                        </select>
                        <input type="text" data-title placeholder="What needs changing?" required />
                        <textarea data-body rows="2" placeholder="Detail (optional)"></textarea>
                        <button type="submit">Request edit</button>
                      </form>
                    </div>
                  </div>
                </div>
              </article>
            );
          })}
        </section>
      ))}
    </main>
  </div>
</BaseLayout>

<script is:inline define:vars={{ DB: REVIEW_DB }}>
  (function () {
    // ── THE BOARD'S CLIENT. Hand-rolled fetch, no SDK ────────────────────────────────────────
    //
    // Supabase's JS client would be a CDN script on a page that currently loads none, for calls
    // that are four headers and a fetch. The repo's rule is no client framework; this honours it
    // and keeps the board's behavior readable in one file.
    //
    // WHAT IS STORED WHERE. The session token goes in localStorage — that is the browser's own
    // login, not the team's data. Every tick, note and edit request lives in Postgres, so two
    // people on two machines see one board. Signed out, nothing loads and nothing can be written:
    // the database refuses the anon key at the schema boundary, so this is belt and braces.
    var SESSION_KEY = "cs_review_session_v1";
    var session = null;
    try { session = JSON.parse(localStorage.getItem(SESSION_KEY) || "null"); } catch (e) {}

    var pages = Array.prototype.slice.call(document.querySelectorAll(".rb-page"));
    var byPath = {};
    pages.forEach(function (el) { byPath[el.dataset.path] = el; });

    var el = {
      auth: document.getElementById("rbAuth"),
      form: document.getElementById("rbSignIn"),
      signed: document.getElementById("rbSigned"),
      who: document.getElementById("rbWho"),
      msg: document.getElementById("rbAuthMsg"),
      sync: document.getElementById("rbSync"),
      pct: document.getElementById("rbPct"),
      done: document.getElementById("rbDone"),
      ring: document.querySelector(".rb-ring"),
    };

    function say(t, bad) { el.sync.textContent = t || ""; el.sync.className = "rb-sync" + (bad ? " is-bad" : ""); }

    // ── REST helpers ────────────────────────────────────────────────────────────────────────
    function rest(path, opts) {
      opts = opts || {};
      var h = {
        apikey: DB.anonKey,
        Authorization: "Bearer " + (session ? session.access_token : DB.anonKey),
        "Content-Type": "application/json",
      };
      // PostgREST needs the schema named explicitly — `review` is not `public`.
      if (opts.method && opts.method !== "GET") h["Content-Profile"] = DB.schema;
      else h["Accept-Profile"] = DB.schema;
      if (opts.prefer) h.Prefer = opts.prefer;
      return fetch(DB.url + "/rest/v1/" + path, {
        method: opts.method || "GET", headers: h,
        body: opts.body ? JSON.stringify(opts.body) : undefined,
      }).then(function (r) {
        if (r.status === 401 || r.status === 403) { signOut(true); throw new Error("session expired"); }
        if (!r.ok) return r.text().then(function (t) { throw new Error(t.slice(0, 160)); });
        return r.status === 204 ? null : r.json();
      });
    }

    // ── auth ────────────────────────────────────────────────────────────────────────────────
    el.form.addEventListener("submit", function (e) {
      e.preventDefault();
      el.msg.textContent = "…";
      fetch(DB.url + "/auth/v1/token?grant_type=password", {
        method: "POST",
        headers: { apikey: DB.anonKey, "Content-Type": "application/json" },
        body: JSON.stringify({
          email: document.getElementById("rbEmail").value,
          password: document.getElementById("rbPass").value,
        }),
      }).then(function (r) { return r.json(); }).then(function (d) {
        if (!d.access_token) { el.msg.textContent = d.error_description || d.msg || "Sign-in failed"; return; }
        session = d;
        localStorage.setItem(SESSION_KEY, JSON.stringify(d));
        el.msg.textContent = "";
        onSignedIn();
      }).catch(function () { el.msg.textContent = "Could not reach the server"; });
    });

    function signOut(expired) {
      session = null;
      localStorage.removeItem(SESSION_KEY);
      el.form.hidden = false; el.signed.hidden = true;
      if (expired) el.msg.textContent = "Session expired — sign in again";
      document.body.classList.remove("rb-live");
    }
    document.getElementById("rbSignOut").addEventListener("click", function () { signOut(false); });

    function onSignedIn() {
      el.form.hidden = true; el.signed.hidden = false;
      el.who.textContent = (session.user && session.user.email) || "";
      document.body.classList.add("rb-live");
      load();
    }

    // ── load everything the board shows ─────────────────────────────────────────────────────
    function load() {
      say("loading…");
      Promise.all([
        rest("page_status?select=*"),
        rest("section_checks?select=*"),
        rest("edit_requests?select=*&order=created_at.desc"),
      ]).then(function (r) {
        applyStatus(r[0]); applySections(r[1]); applyRequests(r[2]);
        paint(); say("");
      }).catch(function (e) { say(e.message, true); });
    }

    function applyStatus(rows) {
      pages.forEach(function (p) {
        p.querySelector(".rb-check").checked = false;
        p.querySelector(".rb-state").value = "";
        p.querySelector(".rb-note").value = "";
        p.removeAttribute("data-status");
      });
      (rows || []).forEach(function (r) {
        var p = byPath[r.path]; if (!p) return;
        p.querySelector(".rb-check").checked = !!r.reviewed;
        p.querySelector(".rb-state").value = r.status || "";
        p.querySelector(".rb-note").value = r.notes || "";
        p.setAttribute("data-status", r.status || "");
        p.classList.toggle("is-done", !!r.reviewed);
      });
    }

    function applySections(rows) {
      pages.forEach(function (p) {
        p.querySelectorAll(".rb-scheck").forEach(function (c) { c.checked = false; });
        p.querySelectorAll(".rb-snote").forEach(function (n) { n.value = ""; });
      });
      (rows || []).forEach(function (r) {
        var p = byPath[r.path]; if (!p) return;
        var c = p.querySelector('.rb-scheck[data-sec="' + r.section_index + '"]');
        var n = p.querySelector('.rb-snote[data-sec="' + r.section_index + '"]');
        if (c) c.checked = !!r.checked;
        if (n) n.value = r.note || "";
      });
    }

    var KIND = { copy: "Copy", design: "Design", data: "Data", bug: "Bug", question: "Question" };
    function applyRequests(rows) {
      pages.forEach(function (p) {
        var box = p.querySelector("[data-reqs]"); if (box) box.innerHTML = "";
        p.setAttribute("data-reqs-open", "0");
      });
      (rows || []).forEach(function (r) {
        var p = byPath[r.path]; if (!p) return;
        var box = p.querySelector("[data-reqs]"); if (!box) return;
        var open = r.status !== "done" && r.status !== "wontfix";
        if (open) p.setAttribute("data-reqs-open", String(+(p.getAttribute("data-reqs-open") || 0) + 1));
        var d = document.createElement("div");
        d.className = "rb-req is-" + r.status;
        d.innerHTML =
          '<div class="rb-req-top"><b></b>' +
          '<span class="rb-req-kind">' + (KIND[r.kind] || r.kind) + "</span>" +
          (r.priority === "high" ? '<span class="rb-req-hi">high</span>' : "") +
          "</div>" +
          '<p class="rb-req-body"></p>' +
          '<div class="rb-req-foot"><select class="rb-req-state">' +
          ["open", "in_progress", "blocked", "done", "wontfix"].map(function (s) {
            return '<option value="' + s + '"' + (s === r.status ? " selected" : "") + ">" + s.replace("_", " ") + "</option>";
          }).join("") +
          "</select></div>";
        // textContent, never innerHTML, for anything a person typed.
        d.querySelector("b").textContent = r.title;
        d.querySelector(".rb-req-body").textContent = r.body || "";
        d.querySelector(".rb-req-state").addEventListener("change", function (e) {
          rest("edit_requests?id=eq." + r.id, { method: "PATCH", body: { status: e.target.value } })
            .then(function () { say("saved"); setTimeout(function () { say(""); }, 900); load(); })
            .catch(function (err) { say(err.message, true); });
        });
        box.appendChild(d);
      });
      paintBadges();
    }

    function paintBadges() {
      pages.forEach(function (p) {
        var n = +(p.getAttribute("data-reqs-open") || 0);
        var b = p.querySelector(".rb-open-reqs");
        if (!b) {
          b = document.createElement("span");
          b.className = "rb-open-reqs";
          p.querySelector(".rb-head").insertBefore(b, p.querySelector(".rb-state"));
        }
        b.textContent = n ? n + " open" : "";
        b.hidden = !n;
      });
    }

    function paint() {
      var done = pages.filter(function (p) { return p.classList.contains("is-done"); }).length;
      var pct = pages.length ? Math.round((done / pages.length) * 100) : 0;
      el.pct.textContent = pct + "%"; el.done.textContent = done;
      el.ring.style.setProperty("--pct", pct);
    }

    // ── writes ──────────────────────────────────────────────────────────────────────────────
    var timers = {};
    function debounce(k, fn) { clearTimeout(timers[k]); timers[k] = setTimeout(fn, 600); }

    function upsertStatus(path, patch) {
      var p = byPath[path];
      var body = Object.assign({
        path: path,
        reviewed: p.querySelector(".rb-check").checked,
        status: p.querySelector(".rb-state").value,
        notes: p.querySelector(".rb-note").value,
      }, patch || {});
      say("saving…");
      rest("page_status?on_conflict=path", { method: "POST", body: [body], prefer: "resolution=merge-duplicates,return=minimal" })
        .then(function () { say("saved"); setTimeout(function () { say(""); }, 900); })
        .catch(function (e) { say(e.message, true); });
    }

    pages.forEach(function (p) {
      var path = p.dataset.path;
      p.querySelector(".rb-check").addEventListener("change", function (e) {
        p.classList.toggle("is-done", e.target.checked); paint(); upsertStatus(path);
      });
      p.querySelector(".rb-state").addEventListener("change", function (e) {
        p.setAttribute("data-status", e.target.value); upsertStatus(path);
      });
      p.querySelector(".rb-note").addEventListener("input", function () {
        debounce("n" + path, function () { upsertStatus(path); });
      });

      p.querySelectorAll(".rb-scheck").forEach(function (c) {
        c.addEventListener("change", function () { upsertSection(p, path, c.dataset.sec); });
      });
      p.querySelectorAll(".rb-snote").forEach(function (n) {
        n.addEventListener("input", function () {
          debounce("s" + path + n.dataset.sec, function () { upsertSection(p, path, n.dataset.sec); });
        });
      });

      var f = p.querySelector("[data-newreq]");
      if (f) f.addEventListener("submit", function (e) {
        e.preventDefault();
        var title = f.querySelector("[data-title]").value.trim();
        if (!title) return;
        say("filing…");
        rest("edit_requests", {
          method: "POST",
          body: [{
            path: path,
            kind: f.querySelector("[data-kind]").value,
            priority: f.querySelector("[data-priority]").value,
            title: title,
            body: f.querySelector("[data-body]").value,
            created_by: session.user.id,
          }],
          prefer: "return=minimal",
        }).then(function () {
          f.reset(); say("filed"); setTimeout(function () { say(""); }, 900); load();
        }).catch(function (err) { say(err.message, true); });
      });

      var tog = p.querySelector(".rb-toggle");
      tog.addEventListener("click", function () {
        var open = tog.getAttribute("aria-expanded") === "true";
        tog.setAttribute("aria-expanded", String(!open));
        p.querySelector(".rb-detail").hidden = open;
      });
    });

    function upsertSection(p, path, idx) {
      var c = p.querySelector('.rb-scheck[data-sec="' + idx + '"]');
      var n = p.querySelector('.rb-snote[data-sec="' + idx + '"]');
      var label = c.closest("li").querySelector("label span").textContent;
      say("saving…");
      rest("section_checks?on_conflict=path,section_index", {
        method: "POST",
        body: [{ path: path, section_index: +idx, section_label: label, checked: c.checked, note: n.value }],
        prefer: "resolution=merge-duplicates,return=minimal",
      }).then(function () { say("saved"); setTimeout(function () { say(""); }, 900); })
        .catch(function (e) { say(e.message, true); });
    }

    // ── filters ─────────────────────────────────────────────────────────────────────────────
    var fbtns = Array.prototype.slice.call(document.querySelectorAll("[data-filter]"));
    fbtns.forEach(function (b) {
      b.addEventListener("click", function () {
        fbtns.forEach(function (o) { o.setAttribute("aria-pressed", String(o === b)); });
        var f = b.dataset.filter;
        pages.forEach(function (p) {
          var show = f === "all"
            || (f === "open" && !p.classList.contains("is-done"))
            || (f === "noted" && p.querySelector(".rb-note").value.trim() !== "")
            || (f === "blocked" && (p.dataset.blocked === "true" || p.getAttribute("data-status") === "blocked"))
            || (f === "absorbed" && p.dataset.folds !== "0")
            || (f === "requests" && +(p.getAttribute("data-reqs-open") || 0) > 0);
          p.hidden = !show;
        });
        document.querySelectorAll(".rb-group").forEach(function (sct) {
          sct.hidden = !Array.prototype.some.call(sct.querySelectorAll(".rb-page"), function (x) { return !x.hidden; });
        });
      });
    });

    var expanded = false;
    document.getElementById("rbExpand").addEventListener("click", function (e) {
      expanded = !expanded;
      pages.forEach(function (p) {
        p.querySelector(".rb-toggle").setAttribute("aria-expanded", String(expanded));
        p.querySelector(".rb-detail").hidden = !expanded;
      });
      e.target.textContent = expanded ? "Collapse all" : "Expand all";
    });

    if (session && session.access_token) onSignedIn();
  })();
</script>

<style is:global>
  /* ── REVIEW BOARD — DELIBERATELY NOT THE WEB DESIGN SYSTEM ─────────────────────────────────
     On instruction. This is a tool, not a page of the site: dense rows, high contrast, monospace
     for paths and lanes so they scan, and a palette that could not be mistaken for the marketing
     site. That mismatch is a feature — an internal board that looks like the live site is one
     somebody eventually shows a customer. */
  body:has(.rb){background:#10151c}
  .rb{--ink:#e8eef5;--dim:#8fa3b8;--line:#243044;--panel:#161d27;--panel2:#1b2431;
      --wip:#3A89C7;--copy:#B7791F;--design:#8fc0ea;--blocked:#C0392B;--done:#16A34A;
      color:var(--ink);font-family:Inter,system-ui,sans-serif;min-height:100vh;padding-bottom:60px}
  .rb *{box-sizing:border-box}

  .rb-top{position:sticky;top:0;z-index:20;background:#10151c;border-bottom:1px solid var(--line);
    padding:20px clamp(14px,3vw,30px) 14px}
  .rb-top-in{display:flex;flex-wrap:wrap;gap:20px;align-items:flex-start;justify-content:space-between;
    max-width:1400px;margin:0 auto}
  .rb-kicker{margin:0 0 4px;font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:#C0392B;font-weight:700}
  .rb h1{margin:0;font-size:1.5rem;color:var(--ink);font-family:Inter,system-ui,sans-serif;letter-spacing:-.01em}
  .rb-sub{margin:5px 0 0;color:var(--dim);font-size:.9rem}

  .rb-progress{display:flex;align-items:center;gap:12px}
  .rb-progress p{margin:0;font-size:.84rem;color:var(--dim)}
  .rb-progress b{color:var(--ink)}
  /* conic-gradient ring — no library, no svg, one element */
  .rb-ring{--pct:0;width:58px;height:58px;border-radius:50%;display:grid;place-items:center;
    background:conic-gradient(var(--done) calc(var(--pct)*1%), #243044 0);font-size:.8rem;font-weight:700}
  .rb-ring span{width:44px;height:44px;border-radius:50%;background:#10151c;display:grid;place-items:center}

  .rb-bar{display:flex;flex-wrap:wrap;gap:10px 18px;justify-content:space-between;align-items:center;
    max-width:1400px;margin:14px auto 0}
  .rb-filters,.rb-tools{display:flex;flex-wrap:wrap;gap:8px}
  .rb button,.rb-import{font:inherit;font-size:.84rem;font-weight:600;cursor:pointer;color:var(--ink);
    background:var(--panel2);border:1px solid var(--line);border-radius:7px;padding:8px 13px;min-height:38px}
  .rb button:hover,.rb-import:hover{background:#222d3d}
  .rb button[aria-pressed=true]{background:var(--wip);border-color:var(--wip);color:#fff}
  .rb .rb-danger{color:#ff9a8f;border-color:#4a2a2a}
  .rb-import{display:inline-flex;align-items:center}
  .rb :focus-visible{outline:2px solid var(--design);outline-offset:2px}
  .rb-warn{max-width:1400px;margin:12px auto 0;font-size:.8rem;color:var(--dim);
    background:#1b1a12;border:1px solid #3a3520;border-radius:7px;padding:9px 12px}

  .rb-body{max-width:1400px;margin:0 auto;padding:22px clamp(14px,3vw,30px) 0}
  .rb-group{margin:0 0 30px}
  .rb-group>h2{font-size:.78rem;letter-spacing:.16em;text-transform:uppercase;color:var(--dim);
    margin:0 0 10px;display:flex;align-items:center;gap:10px}
  .rb-count{background:var(--panel2);border:1px solid var(--line);border-radius:20px;padding:1px 9px;font-size:.72rem;letter-spacing:0}

  .rb-page{background:var(--panel);border:1px solid var(--line);border-radius:9px;margin-bottom:7px;overflow:hidden}
  .rb-page[hidden]{display:none}
  /* Status shows as a left edge — visible while scanning fifty rows, invisible when you are not
     looking for it. */
  .rb-page[data-status=reviewing]{border-left:4px solid var(--wip)}
  .rb-page[data-status=copy]{border-left:4px solid var(--copy)}
  .rb-page[data-status=design]{border-left:4px solid var(--design)}
  .rb-page[data-status=blocked]{border-left:4px solid var(--blocked)}
  .rb-page[data-status=done],.rb-page.is-done{border-left:4px solid var(--done)}
  .rb-page.is-done .rb-title{text-decoration:line-through;color:var(--dim)}

  .rb-head{display:flex;align-items:center;gap:10px;padding:9px 12px}
  .rb-check{width:19px;height:19px;flex:none;accent-color:#16A34A;cursor:pointer}
  .rb-toggle{flex:1;min-width:0;display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px;
    background:none!important;border:none!important;text-align:left;padding:4px 0!important;min-height:0!important}
  .rb-title{font-weight:600;font-size:.98rem}
  .rb-head code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.78rem;color:var(--dim)}
  .rb-lane{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.7rem;color:var(--dim);
    background:var(--panel2);border-radius:5px;padding:3px 7px;white-space:nowrap}
  .rb-flag{font-size:.68rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
    color:#ffb3a7;background:#3a1f1c;border-radius:5px;padding:3px 7px;white-space:nowrap}
  .rb-state{font:inherit;font-size:.8rem;background:var(--panel2);color:var(--ink);
    border:1px solid var(--line);border-radius:7px;padding:6px 8px;min-height:36px;cursor:pointer}
  .rb-open{font-size:.8rem;color:var(--design);text-decoration:none;white-space:nowrap;padding:6px}
  .rb-open:hover{text-decoration:underline}

  .rb-detail{border-top:1px solid var(--line);background:#131a24;padding:14px}
  .rb-detail[hidden]{display:none}
  .rb-why{margin:0 0 12px;font-size:.84rem;color:#ffcfc7;background:#2a1a18;border-radius:7px;padding:9px 11px}
  .rb-cols{display:grid;grid-template-columns:1.3fr 1fr;gap:20px}
  .rb-detail h3{margin:0 0 8px;font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--dim)}
  .rb-sections{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:5px}
  .rb-sections li{display:grid;grid-template-columns:1fr 190px;gap:8px;align-items:center}
  .rb-sections label{display:flex;align-items:center;gap:9px;font-size:.87rem;cursor:pointer;min-width:0}
  .rb-sections input[type=checkbox]{width:16px;height:16px;flex:none;accent-color:#3A89C7;cursor:pointer}
  .rb-snote,.rb-note{font:inherit;font-size:.83rem;background:#0e141c;color:var(--ink);
    border:1px solid var(--line);border-radius:6px;padding:7px 9px;width:100%}
  .rb-snote::placeholder,.rb-note::placeholder{color:#5d6f83}
  .rb-note{resize:vertical;line-height:1.5}


  /* ── WHY 68 AND NOT 443 ─────────────────────────────────────────────────────────────────── */
  .rb-why-panel{max-width:1400px;margin:22px auto 0;padding:20px clamp(14px,3vw,30px);
    background:var(--panel);border:1px solid var(--line);border-radius:10px}
  .rb-why-panel h2{margin:0 0 8px;font-size:1.05rem;color:var(--ink)}
  .rb-why-lead{margin:0 0 16px;font-size:.92rem;color:var(--dim);max-width:80ch;line-height:1.6}
  .rb-why-lead b{color:var(--ink)}
  .rb-why-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px}
  .rb-why-card{background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:13px 14px;
    display:flex;flex-direction:column;gap:5px}
  .rb-why-card b{font-size:1.5rem;line-height:1;color:var(--design)}
  .rb-why-card strong{font-size:.86rem;color:var(--ink)}
  .rb-why-card span{font-size:.78rem;color:var(--dim);line-height:1.5}
  .rb-why-foot{margin:14px 0 0;font-size:.82rem;color:var(--dim)}

  /* the fold badge on a row, and the list inside it */
  .rb-fold-badge{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.7rem;font-weight:700;
    color:#cfe3f7;background:#1d3550;border-radius:5px;padding:3px 7px;white-space:nowrap}
  .rb-folds{list-style:none;margin:0 0 16px;padding:0;max-height:230px;overflow:auto;
    display:flex;flex-direction:column;gap:3px;border:1px solid var(--line);border-radius:7px;padding:8px}
  .rb-folds li{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 10px}
  .rb-folds code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.76rem;color:#b9cbde;
    word-break:break-all}
  .rb-reason{font-size:.68rem;color:var(--dim);background:var(--panel2);border-radius:4px;padding:2px 6px;
    white-space:nowrap;cursor:help}
  .rb-none{margin:0 0 16px;font-size:.83rem;color:var(--dim);font-style:italic}


  /* ── AUTH BAR + CMS CONTROLS ─────────────────────────────────────────────────────────────── */
  .rb-auth{max-width:1400px;margin:12px auto 0}
  .rb-signin{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
  .rb-auth-lead{font-size:.86rem;color:var(--dim);margin-right:4px}
  .rb-signin input{font:inherit;font-size:.86rem;background:#0e141c;color:var(--ink);
    border:1px solid var(--line);border-radius:7px;padding:9px 11px;min-height:38px;min-width:210px}
  .rb-auth-msg{font-size:.82rem;color:#ffb3a7}
  .rb-signed{display:flex;flex-wrap:wrap;gap:12px;align-items:center;font-size:.86rem;color:var(--dim)}
  .rb-signed b{color:var(--ink)}
  .rb-sync{font-size:.8rem;color:var(--done);min-width:70px}
  .rb-sync.is-bad{color:#ff9a8f}

  /* Signed out, the interactive parts are visibly inert rather than misleadingly clickable. */
  .rb-detail .rb-note,.rb-detail .rb-snote,.rb-newreq,.rb-check,.rb-scheck,.rb-state{opacity:.45;pointer-events:none}
  body.rb-live .rb-detail .rb-note,body.rb-live .rb-detail .rb-snote,body.rb-live .rb-newreq,
  body.rb-live .rb-check,body.rb-live .rb-scheck,body.rb-live .rb-state{opacity:1;pointer-events:auto}

  /* ── EDIT REQUESTS ───────────────────────────────────────────────────────────────────────── */
  .rb-open-reqs{font-size:.68rem;font-weight:700;color:#0e141c;background:var(--copy);
