  .rb-newreq{display:grid;grid-template-columns:auto auto 1fr;gap:7px;align-items:start;
    background:#0e141c;border:1px dashed var(--line);border-radius:8px;padding:11px}
  .rb-newreq select{font:inherit;font-size:.8rem;background:var(--panel2);color:var(--ink);
    border:1px solid var(--line);border-radius:6px;padding:7px}
  .rb-newreq input[type=text]{grid-column:3;font:inherit;font-size:.84rem;background:var(--panel2);
    color:var(--ink);border:1px solid var(--line);border-radius:6px;padding:7px 9px}
  .rb-newreq textarea{grid-column:1/-1;font:inherit;font-size:.83rem;background:var(--panel2);
