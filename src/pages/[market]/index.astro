---
// TEMPLATE 2 — MARKET LANDING. ONE file, three pages.
//
// This is the proof that the extraction worked. Cincinnati, Columbus and St. Louis are the same
// ordered list of section blocks; the only thing that differs is which market object and which
// content object get passed in. Adding a fourth market is a data file and a line in markets.js —
// no new layout, no copy-pasted section.
//
// Section order follows site-plan's market-landing definition and the built reference page:
// offer hero + lead form · trust badges · services in this market · why us · served areas ·
// local reviews · offer band · FAQ written local · final CTA · footer NAP.
import BaseLayout from "../../layouts/BaseLayout.astro";
import UtilityBar from "../../components/UtilityBar.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import MarketNotice from "../../components/MarketNotice.astro";
import Hero from "../../components/Hero.astro";
import BadgeRow from "../../components/BadgeRow.astro";
import ServicesGrid from "../../components/ServicesGrid.astro";
import WhyTrust from "../../components/WhyTrust.astro";
import ServiceDetail from "../../components/ServiceDetail.astro";
import ServedAreas from "../../components/ServedAreas.astro";
import TeamPhoto from "../../components/TeamPhoto.astro";
import MarketDepth from "../../components/MarketDepth.astro";
import PartnerStrip from "../../components/PartnerStrip.astro";
import Reviews from "../../components/Reviews.astro";
import OfferBand from "../../components/OfferBand.astro";
import FAQ from "../../components/FAQ.astro";
import CTABand from "../../components/CTABand.astro";
import SiteFooter from "../../components/SiteFooter.astro";

import { businessNode } from "../../data/seo.js";
import { MARKETS, businessId } from "../../data/markets.js";
import { TESTIMONIALS } from "../../data/claims.js";
import { cincinnati } from "../../data/pages/cincinnati.js";
import { columbus } from "../../data/pages/columbus.js";
import { stLouis } from "../../data/pages/st-louis.js";

const CONTENT = { cincinnati, columbus, "st-louis": stLouis };

export async function getStaticPaths() {
  const { MARKETS } = await import("../../data/markets.js");
  return Object.keys(MARKETS).map((market) => ({ params: { market } }));
}

const { market: slug } = Astro.params;
const market = MARKETS[slug];
const page = CONTENT[slug];
const o = market.office;

// THE ONLY LocalBusiness NODE FOR THIS MARKET. One per market, on the market landing page, with
// the one real office address. Service hubs and location pages reference it by @id rather than
// restating the NAP, so there is exactly one place on the site where each address is written and
// no page can drift from the GBP listing. No aggregateRating — see Reviews.astro.
//
// ROUND 42: the node's contents moved to data/seo.js so the national page and this one describe
// the same business the same way. It gained parentOrganization, a logo, an offer catalogue and a
// telephone that is a phone number rather than a tel: href. The address still comes from here.
const localBusiness = businessNode(market);

// No hero media and no modal on a market landing: the ground is the navy gradient, exactly as
// the prototype has it. When a market has its own crew footage or a real photograph, pass it as
// `media` here — that is the only change needed, and it is per-market by design.
---
<BaseLayout
  title={page.title}
  description={page.description}
  canonical={`/${market.slug}/`}
  market={market}
  breadcrumbs={[{ name: "Home", href: "/" }, { name: market.name, href: `/${market.slug}/` }]}
  schema={[localBusiness]}
>
  <Fragment slot="chrome-top">
    <UtilityBar market={market} resolvedFrom="path" />
    <SiteHeader market={market} />
  </Fragment>

  <Hero market={market} {...page.hero} />
  <MarketNotice market={market} />
  <BadgeRow market={market} aboveTheFold={true} />

  <ServicesGrid market={market} heading={page.services.heading} intro={page.services.intro} />
  <WhyTrust heading={page.why.heading} cards={page.why.cards}
            reviews={TESTIMONIALS[slug]} marketSlug={slug} />
  <ServiceDetail id="roofing" market={market} {...page.roofing} />

  {/* THE ROOFING SCRUB MOVED TO /[market]/roofing/ — it is not on this page any more.
      A market landing has to cover four trades and route to all of them; 360vh of sticky track
      about one of them made roofing the whole middle of the page and pushed siding, windows and
      gutters below it. On the roofing hub the same section is the subject of the page rather than
      a detour from it. See [market]/[service].astro, where it is now driven by PROCESS_MEDIA. */}

  {/* `intro` is deliberately not passed: all three markets said "Based at our <office> office —
      serving these communities", which is what the component's own lede now derives from
      markets.js. Two sentences saying it was one more than the section needed, and the derived one
      cannot drift from the office data. The prop still exists for callers with something to add. */}
  {/* The depth pass. Sits after the roofing detail, where a reader who has decided we do the work
      wants to know whether we understand their houses. Written per market from its own climate and
      stock — see MarketDepth.astro on why it is not a template. */}
  <MarketDepth market={market} depth={page.depth} />

  {/* Team photo sits after the areas list and before reviews: the page has just said where we
      work, and this says who turns up. Placeholder — see TeamPhoto.astro. */}
  <TeamPhoto market={market} />

  {/* WHAT WE INSTALL — MARKET-SCOPED, AND IT RENDERS ONLY WHERE THE DATA EXISTS.
      Named per market in markets.js; a market with no `partners` array gets no section at all,
      which is why this is St. Louis-only today. That is deliberate rather than unfinished: the
      national strip speaks for the company, and inventing a product list for a market nobody has
      confirmed one for is the kind of thing this repo's gates exist to stop. Give Cincinnati or
      Columbus an array and their strip appears with no change here.

      It sits after the local depth copy and before the served areas — the material a homeowner
      would be choosing between, then where we bring it. */}
  {market.partners?.length && (
    <PartnerStrip
      market={market}
      eyebrow="What we install"
      heading={`The brands we fit across ${market.region}`}
      intro="Products with real manufacturer warranties and training behind the installation, because a warranty is only as good as the crew that fits the material."
    />
  )}

  <ServedAreas market={market} heading={page.areas.heading} />
  <Reviews heading={page.reviews.heading} intro={page.reviews.intro} reviews={TESTIMONIALS[slug]} />
  <OfferBand />
  <FAQ items={page.faq} />
  <CTABand market={market} heading={page.cta.heading} body={page.cta.body} />

  <Fragment slot="chrome-bottom">
    <SiteFooter market={market} />
  </Fragment>
</BaseLayout>
