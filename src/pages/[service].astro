---
// TEMPLATE 3N — THE NATIONAL SERVICE PAGES. /roofing/, /siding/, /windows/, /gutters/.
//
// WHY THESE NOW EXIST. The header renders a link per service on every page. On a market page each
// one went to that market's hub; on the national pages `serviceHref` had no market to work with
// and returned `/#services` — so Roofing, Siding, Windows and Gutters were four links to the same
// anchor on the page you were already on. Four nav items, one destination, no page. The pages were
// never built, which is why they were never linked.
//
// THEY ARE NOT A FOURTH COPY OF THE HUB. A market hub answers "roofing in Cincinnati" and carries
// that market's proof, phone and areas. This answers "does Coldstream do roofing", and its job is
// to say what the service is and then route to the market that will actually do it. The market
// chooser is the substance of the page, not a footer on it.
//
// SEO. Self-canonical and indexable. The shared service copy lives here and on the hubs — the
// hubs' uniqueness comes from their local copy, which this page deliberately does not have and
// does not fake. What it must never do is compete with them on a city term, so nothing here is
// written against a city.
//
// FIVE PAGES, NOT SIX. The set is every service the footer links nationally: the four homeowner
// services plus commercial roofing, which is a different buyer and stays out of the header but is
// linked from every footer — that link was pointing at a page that did not exist. Garage doors is
// excluded because it is one market's service line and nothing national links to it; a national
// page for a St. Louis-only service would be a page about one office pretending to be four.
import BaseLayout from "../layouts/BaseLayout.astro";
import UtilityBar from "../components/UtilityBar.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import BadgeRow from "../components/BadgeRow.astro";
import ServiceDetail from "../components/ServiceDetail.astro";
import MarketDepth from "../components/MarketDepth.astro";
import ProcessScrub from "../components/ProcessScrub.astro";
import MarketChooser from "../components/MarketChooser.astro";
import HowItWorks from "../components/HowItWorks.astro";
import WhyTrust from "../components/WhyTrust.astro";
import PartnerStrip from "../components/PartnerStrip.astro";
import FAQ from "../components/FAQ.astro";
import CTABand from "../components/CTABand.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { NATIONAL, MARKET_LIST, MARKETS, servicesFor, offers } from "../data/markets.js";
import { SERVICE_CONTENT, NATIONAL_DEPTH } from "../data/services.js";
import { PROCESS, PROCESS_INTRO } from "../data/process.js";
import { orgRef } from "../data/seo.js";
import { placeNode } from "../data/seo.js";

// A service gets a national page when more than one market runs it. That is exactly the set the
// header and footer link nationally, and it is the test that keeps a single-market service line
// from getting a page that speaks for three metros.
export function getStaticPaths() {
  return servicesFor(NATIONAL)
    .filter((s) => MARKET_LIST.filter((m) => offers(m, s.key)).length > 1)
    .map((s) => ({ params: { service: s.key } }));
}

const { service } = Astro.params;
const svc = SERVICE_CONTENT[service];
const market = NATIONAL;

const LEAD = {
  "commercial-roofing": "Flat and low-slope roofing for multi-family, HOA and commercial properties — installed, restored and repaired.",
  roofing: "Replacement, repair and storm work — asphalt, metal and flat systems, quoted after a free inspection.",
  siding: "James Hardie fiber cement and vinyl siding, installed and repaired for the whole exterior.",
  windows: "Energy-efficient replacement windows, measured and installed by trained crews.",
  gutters: "Seamless gutters, guards and downspouts, sized to the roof they are draining.",
};

const INTRO = {
  "commercial-roofing": "A commercial roof is a different job from a residential one in every way that matters: the deck, the drainage, the phasing and who has to sign it off. We survey it, write the scope so a board or an owner can read it, and schedule around the building staying occupied rather than around our own convenience.",
  roofing: "Roofing is the core of the business and the reason most people call us first. The same crews work all three metros, the same 25-year workmanship warranty covers the work in each, and every job starts with someone walking the roof rather than pricing it off a satellite image.",
  siding: "Siding is where most of the complaints in this trade come from, and almost none of them are about the material — they are about how it was fitted. We install Hardie and vinyl to the manufacturer's specification, and we take the old course off so the sheathing underneath gets looked at.",
  windows: "A window job is measured opening by opening, because the openings in a house that predates 1970 are not the same size as each other. We fit insert and full-frame replacements across all three metros, and we will tell you when a repair is the honest answer instead.",
  gutters: "Gutters are the smallest line on an exterior quote and the one that does the most damage when it fails, because everything it fails onto costs more than they did. We roll seamless lengths on site in all three metros and size them to the roof that is draining into them.",
};

const title = {
  // CITIES DELIBERATELY ABSENT from these two, and not only for length: this template's own
  // rule is that a national page "must never compete with [the market hubs] on a city term".
  // The city list was doing exactly that from the title while the body carefully did not.
  roofing: "Roofing Contractors | Coldstream Exteriors",
  siding: "Siding Installation & Replacement | Coldstream Exteriors",
  windows: "Replacement Windows | Coldstream Exteriors",
  gutters: "Seamless Gutters, Guards & Downspouts | Coldstream Exteriors",
  "commercial-roofing": "Commercial & Multi-Family Roofing | Coldstream Exteriors",
}[service];

const description = {
  roofing: "Roof replacement, repair and storm damage work — free inspections, a written quote first, and a 25-year workmanship warranty on every job.",
  siding: "James Hardie fiber cement and vinyl siding, installed to the manufacturer's specification — with a free inspection first.",
  windows: "Energy-efficient replacement windows — insert and full-frame, measured opening by opening rather than averaged from a plan.",
  gutters: "Seamless gutters, gutter guards and downspouts, sized to the roof draining into them.",
  "commercial-roofing": "Flat and low-slope roofing for multi-family, HOA and commercial properties in Cincinnati and Columbus. TPO, EPDM, coatings and scheduled maintenance.",
}[service];

// THE H1 CARRIES NO CITY NAME, for the same reason the title above stopped carrying one.
//
// Round 41 took the three cities out of the title on this template's own instruction — "a national
// page must never compete with [the market hubs] on a city term" — and left the H1 saying
// "Roofing across Cincinnati, Columbus and St. Louis". The H1 is the stronger on-page signal of
// the two, so the fix was half-applied: the page was still bidding for the city terms its own
// market pages are built to win, just from a different element.
//
// The cities remain in the meta description, which is where round 41 decided they belong: it is
// read by a person deciding whether to click, not weighed as a heading.
const h1 = {
  roofing: "Roofing contractors who walk the roof first",
  siding: "Siding, fitted by the crew that measured it",
  windows: "Replacement windows, measured opening by opening",
  gutters: "Seamless gutters, sized to the roof above them",
  "commercial-roofing": "Commercial and multi-family roofing",
}[service];

// The market chooser only offers markets that actually run this service.
const markets = MARKET_LIST.filter((m) => offers(m, service));

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: svc.label,
  provider: orgRef(),
  areaServed: markets.map((m) => placeNode(m.name)),
};
// Same map as [market]/[service].astro, and the same rule: the FOOTAGE is the gate, not the
// service list. Gutters has no clip yet, so the national gutters page renders no section at all
// rather than a placeholder — ProcessScrub returns nothing without a poster and a source.
//
// The component needs no market: its steps describe how the work is done, not where, so the
// national page and the three market pages show the identical sequence. That is why generalising
// RoofBuild was worth doing rather than writing a national variant.
const PROCESS_MEDIA = {
  roofing: { poster: "/video/roof-build-poster.jpg", mp4: "/video/roof-build-scrub.mp4" },
  siding: { poster: "/video/siding-build-poster.jpg", mp4: "/video/siding-build-scrub.mp4" },
  // GUTTERS HAS NO CLIP (removed 2026-08-21, on instruction). ProcessScrub renders nothing
  // without a poster and a source, so the gutters pages simply carry no scrub section.
};
const scrubMedia = PROCESS_MEDIA[service] ?? null;
const scrubSteps = PROCESS[service] ?? [];
const scrubIntro = PROCESS_INTRO[service] ?? {};

---
<BaseLayout
  title={title}
  description={description}
  canonical={`/${service}/`}
  market={market}
  breadcrumbs={[{ name: "Home", href: "/" }, { name: svc.label, href: `/${service}/` }]}
  schema={[schema]}
>
  <Fragment slot="chrome-top">
    <UtilityBar market={market} resolvedFrom="default" />
    <SiteHeader market={market} />
  </Fragment>

  <Hero
    market={market}
    eyebrow={`${svc.label} — all three metros`}
    headline={h1}
    sub={LEAD[service]}
  />

  <BadgeRow market={market} aboveTheFold={true} />

  <ServiceDetail
    id={service}
    market={market}
    eyebrow="What we do"
    heading={`What a ${svc.label.toLowerCase()} job covers`}
    intro={INTRO[service]}
    cards={svc.sections}
  />

  {/* NATIONAL DEPTH — same slot the market template gives MarketDepth: straight after the cards
      that say what the work is, before anything about us. A reader weighing materials should hit
      the material argument next, not the trust band. Renders nothing for a service with no block
      (commercial-roofing, by design — a different buyer on a different search). */}
  <MarketDepth market={market} depth={NATIONAL_DEPTH[service]} />

  {/* Below the fold, after the detail cards that describe the work and before the FAQ — the same
      position it holds in [market]/[service].astro. Never behind hero copy: verify-build's fixed
      13.6:1 and 7.1:1 hold only while no page passes media to Hero. See ProcessScrub.astro. */}
  <ProcessScrub
    id={`${service}-process`}
    media={scrubMedia}
    {...scrubIntro}
    steps={scrubSteps}
  />

  {/* WAS a bespoke .ns-pick grid. Same question the home page asks, so it is the same component
      now — see MarketChooser.astro. It keeps the deep link this page always had: the cards go to
      that market's page for THIS service, not to the market landing, because someone reading the
      national siding page wants Columbus siding rather than Columbus. */}
  <MarketChooser
    heading={`Who does this where you are`}
    intro="Each metro is its own office, crew and number. The market page carries the local detail — the building stock, the weather, and the areas we cover."
    markets={markets}
    service={service}
    note={markets.length < MARKET_LIST.length
      ? "Not offered in every market — the ones listed are the ones that run this service line."
      : null}
  />

  {svc.process && (
    <HowItWorks
      eyebrow="What happens next"
      heading={`How a ${svc.label.toLowerCase()} job runs`}
      steps={svc.process}
    />
  )}

  <WhyTrust
    heading="Straightforward from quote to cleanup"
    cards={[
      { title: "Honest, upfront pricing", body: "A clear quote after a free inspection — no surprises, no pressure, no games on price." },
      { title: "One project manager, start to finish", body: "The person who quotes the job runs the job, and is the person you call afterwards." },
      { title: "Backed by a 25-year warranty", body: "A 25-year workmanship warranty, fully insured, and one team for the whole exterior." },
    ]}
  />

  <PartnerStrip
    eyebrow="What we install"
    heading="Materials from manufacturers who stand behind them"
    intro="We install products with real manufacturer warranties and training behind the installation, because a warranty is only as good as the crew that fits the material."
  />

  <FAQ items={svc.faq} />

  <CTABand market={market} heading="Ready for a free, no-pressure estimate?" body="Tell us what you need — we'll take a look and give you an honest number." />

  <Fragment slot="chrome-bottom">
    <SiteFooter market={market} />
  </Fragment>
</BaseLayout>

{/* The scoped .ns-* styles that were here belonged to the bespoke market grid this page no
    longer renders. Its replacement, MarketChooser, carries its own styles in base.css. */}

