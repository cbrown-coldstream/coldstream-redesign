---
// TEMPLATE 3S — THE NATIONAL SUB-SERVICE PAGES. /roofing/replacement/, /roofing/repair/,
// /siding/vinyl-siding/, /siding/james-hardie-siding/, /siding/stone-veneer/.
//
// WHY THESE EXIST. Same reason the national hubs in [service].astro exist, one level down. The
// header renders a dropdown under Roofing and Siding on every page. On a market page each child
// went to that market's sub-service page; on a national page `childHref` had no market to work
// with and returned the parent hub — so every child in both dropdowns pointed at the page you
// were already standing on. Five nav items, two destinations, no pages.
//
// THEY ARE NOT A FOURTH COPY OF THE MARKET SUB-SERVICE PAGE. The market page answers "vinyl siding
// in Columbus" and carries that market's climate, crew, phone and served areas. This answers "what
// is vinyl siding and how does it fail", which is the same question in all three metros. NO CITY
// APPEARS ON THESE PAGES — the market chooser is how a reader gets from here to the local page,
// and it deep-links to that market's version of THIS sub-service rather than to the market landing.
// See the header of data/national-subservices.js for the full split and for the slug mapping.
//
// SEO. Self-canonical and indexable, and the breadcrumb runs Home › Hub › This page so the hub
// above stays the stronger URL. `npm run similarity` is the check that these did not drift into
// being the market pages with the city removed; the market sub-service pairs are already reported
// there and these join them.
import BaseLayout from "../../layouts/BaseLayout.astro";
import UtilityBar from "../../components/UtilityBar.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import Hero from "../../components/Hero.astro";
import BadgeRow from "../../components/BadgeRow.astro";
import ServiceDetail from "../../components/ServiceDetail.astro";
import MarketDepth from "../../components/MarketDepth.astro";
import HowItWorks from "../../components/HowItWorks.astro";
import WhyTrust from "../../components/WhyTrust.astro";
import ProjectShowcase from "../../components/ProjectShowcase.astro";
import { ALWAYS_TRUE } from "../../data/claims.js";
import { HARDIE_SHOWCASE } from "../../data/projects.js";
import PartnerStrip from "../../components/PartnerStrip.astro";
import FAQ from "../../components/FAQ.astro";
import CTABand from "../../components/CTABand.astro";
import SiteFooter from "../../components/SiteFooter.astro";

import { NATIONAL, MARKET_LIST, offers, serviceFor } from "../../data/markets.js";
import { NATIONAL_SUBSERVICES, nationalSubservicePaths } from "../../data/national-subservices.js";
import { orgRef } from "../../data/seo.js";
import { placeNode } from "../../data/seo.js";

export function getStaticPaths() {
  return nationalSubservicePaths().map(({ hub, sub }) => ({ params: { hub, sub } }));
}

const { hub, sub } = Astro.params;
const svc = NATIONAL_SUBSERVICES[hub][sub];
const market = NATIONAL;
const parent = serviceFor(hub);

// Only markets that actually run the parent hub. A chooser offering a market that cannot do the
// job is worse than one that lists fewer — the same rule MarketChooser documents.
const markets = MARKET_LIST.filter((m) => offers(m, hub));

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: svc.label,
  name: svc.h1,
  description: svc.lead,
  url: `https://coldstreamexteriors.com/${hub}/${sub}/`,
  // Organization rather than a LocalBusiness ref: this page speaks for the company across three
  // metros, so pinning it to one office's @id would be wrong. No address is emitted here — the
  // three real ones live on the market landings and nowhere else.
  provider: orgRef(),
  areaServed: markets.map((m) => placeNode(m.name)),
  isPartOf: { "@type": "WebPage", "@id": `https://coldstreamexteriors.com/${hub}/` },
};
---
<BaseLayout
  title={svc.title}
  description={svc.description}
  canonical={`/${hub}/${sub}/`}
  market={market}
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: parent.label, href: `/${hub}/` },
    { name: svc.label, href: `/${hub}/${sub}/` },
  ]}
  schema={[schema]}
>
  <Fragment slot="chrome-top">
    <UtilityBar market={market} resolvedFrom="default" />
    <SiteHeader market={market} />
  </Fragment>

  <Hero
    market={market}
    eyebrow={`${parent.label} · ${svc.label}`}
    headline={svc.h1}
    sub={svc.lead}
  />

  <BadgeRow market={market} aboveTheFold={true} />

  {/* THE LEAD. Was one bare muted paragraph alone in a section — owner, 2026-08-27: "alone and
      bare. Bring more style to this." Now the intro reads at lead size beside the always-true
      panel, so the page opens with substance. The panel repeats the three claims every surface
      repeats, from the one array that keeps them phrased identically. */}
  <section class="sublead">
    <div class="wrap">
      <div class="sublead-copy">
        <p>{svc.intro}</p>
      </div>
      <aside class="sublead-aside" aria-label="True on every job">
        <p class="sublead-t">On every job</p>
        <ul>
          {ALWAYS_TRUE.map((t) => <li>{t}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  {/* THE HARDIE SHOWCASE (owner, 2026-08-27): real completed homes in a rotating strip, directly
      after the lead. Only this sub-service has verified photos of its material — the entries and
      their sourcing live in data/projects.js. Two labeled pending cards hold space for the homes
      the owner is providing later. */}
  {sub === "james-hardie-siding" && (
    <ProjectShowcase
      id="hardie-homes"
      heading="James Hardie homes we've completed"
      intro="Real projects by our crews — no stock photography. More are on the way."
      items={HARDIE_SHOWCASE}
      pending={2}
    />
  )}

  <ServiceDetail
    id={sub}
    market={market}
    eyebrow="What the work involves"
    heading={`What a ${svc.label.toLowerCase()} job covers`}
    cards={svc.sections}
  />

  {/* The material argument, straight after the summary cards and before any shared trust copy —
      a reader choosing between products should reach it before the boilerplate. The market shim
      only supplies a stable heading id; NATIONAL.slug is null and would render `mdepth-null` on
      every one of these pages. Nothing else in the component reads the market. */}
  <MarketDepth market={{ ...market, slug: `${hub}-${sub}` }} depth={svc.depth} />

  <HowItWorks
    eyebrow="What happens next"
    heading={`How a ${svc.label.toLowerCase()} job runs`}
    steps={svc.process}
  />

  {/* Metro listing removed 2026-08-26 — /service-areas/ owns it; the utility bar routes. */}

  <WhyTrust
    heading="Straightforward from quote to cleanup"
    cards={[
      { title: "Honest, upfront pricing", body: "A clear written quote after a free inspection — no surprises and no pressure afterwards." },
      { title: "One project manager, start to finish", body: "The person who quotes the job runs the job, and is the person you call afterwards." },
      { title: "Backed by industry-leading warranties", body: "Industry-leading warranties, fully licensed and insured, and one team for the whole exterior." },
    ]}
  />

  <PartnerStrip
    eyebrow="What we install"
    heading="Materials from manufacturers who stand behind them"
    intro="We install products with real manufacturer warranties and training behind the installation, because a warranty is only as good as the crew that fits the material."
  />

  <FAQ items={svc.faq} />

  <CTABand
    market={market}
    heading="Ready for a free, no-pressure estimate?"
    body={`Tell us what you need and we will take a look. Call ${market.phone} or send the form.`}
  />

  <Fragment slot="chrome-bottom">
    <SiteFooter market={market} />
  </Fragment>
</BaseLayout>
