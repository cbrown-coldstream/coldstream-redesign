---
// TEMPLATE 1 — NATIONAL HOME. The only instance.
//
// Built to site-plan's SEVEN sections. It is not the market landing template with the city
// swapped: the plan gives the two different jobs and different section sets, and the ruling
// confirmed the plan wins over the earlier brief on this point.
//
// THE BADGE ROW AND THE HERO VIDEO ARE NOW ON THIS PAGE (round 5). Both were held back in an
// earlier round — requested in a brief, absent from the plan's seven sections for this template —
// and flagged as pending a decision rather than quietly included. Round 5 is that decision.
//
// Both are the same components the market landings use, so there is one badge row and one hero on
// this site, not a national variant of each. The video is progressive enhancement and never the
// LCP resource; see Hero.astro. The BBB slot in the badge row stays gated — see BadgeRow.astro.
//
// SEO. This page is static, national, and self-canonical. No redirect to a market, no
// client-side content swap, no cloaking — a crawler and a visitor from Phoenix get exactly the
// same HTML. Personalisation is the visible router below plus an optional client-side geo
// nudge, neither of which changes what is indexed.
import BaseLayout from "../layouts/BaseLayout.astro";
import UtilityBar from "../components/UtilityBar.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import BadgeRow from "../components/BadgeRow.astro";
import MarketChooser from "../components/MarketChooser.astro";
import PartnerStrip from "../components/PartnerStrip.astro";
import GeoRedirect from "../components/GeoRedirect.astro";
import MarketNotice from "../components/MarketNotice.astro";
import FAQ from "../components/FAQ.astro";
import CTABand from "../components/CTABand.astro";
import WhatWeDo from "../components/WhatWeDo.astro";
import OffersSection from "../components/OffersSection.astro";
import WhyTrust from "../components/WhyTrust.astro";
import ReviewsByMarket from "../components/ReviewsByMarket.astro";
import Reviews from "../components/Reviews.astro";
import SiteFooter from "../components/SiteFooter.astro";

import { NATIONAL, MARKET_LIST, MARKETS, GEO, servicesFor, serviceHref, copyFor } from "../data/markets.js";
import { TESTIMONIALS, ALWAYS_TRUE, CLAIMS } from "../data/claims.js";

// HERO SUB AND TRUST ROW, COMPOSED HERE — the brief requires the approved figures read from
// claims.js so a change to the number propagates, and formatted at the point of display so the
// raw integer stays reusable in schema. The trust row replaces the generic bullet trio on this
// page only: Locally Owned & Operated · BBB A+ Accredited (text; the seal itself is in the badge
// row) · Fully Insured — the last is owner-approved wording from the same brief, a deliberate
// step past ALWAYS_TRUE's "Licensed and insured".
const satisfied = CLAIMS.satisfiedCustomers.toLocaleString("en-US");
const heroSub =
  "Roof replacement and repair, James Hardie and vinyl siding, seamless gutters, replacement " +
  "windows and storm damage restoration. One team for every exterior need — " +
  CLAIMS.warrantyPositioning.toLowerCase() + ", and a track record of over " + satisfied +
  " satisfied homeowners.";
// Two why-cards take their titles from claims.js — the satisfied count and the warranty
// positioning phrase — formatted here, at the point of display, per the brief.
const whyCards = page.why.cards.map((c) =>
  c.id === "satisfied" ? { ...c, title: `Over ${satisfied} satisfied homeowners` }
  : c.id === "warranty" ? { ...c, title: CLAIMS.warrantyPositioning }
  : c);
const heroTrust = [
  "Locally Owned & Operated",
  ...(CLAIMS.bbb?.accredited && CLAIMS.bbb?.rating ? [`BBB ${CLAIMS.bbb.rating} Accredited`] : []),
  "Fully Insured",
];
import { organizationNode } from "../data/seo.js";
import { national as page } from "../data/pages/national.js";

const market = NATIONAL;

// THE MODAL'S FILE, and only the modal's. The hero ground is the navy gradient — no media prop
// is passed, so the placeholder logo plate no longer paints behind the headline on any page.
// This is still placeholder footage; it plays because a visitor chose to open it, which is a
// different bargain from a placeholder painted behind the H1 whether or not anyone asked.
const video = {
  poster: "/video/hero-poster.jpg",
  mp4: "/video/hero-placeholder.mp4",
  webm: "/video/hero-placeholder.webm",
};

// One Organization node with all three offices, rather than a LocalBusiness — the national page
// is not a location and should not claim to be one. LocalBusiness lives on the market pages.
//
// ROUND 42: the node itself moved to data/seo.js. It was written out here, again on /about-us/
// and a third time in [market]/index.astro, and the three copies had already diverged — only the
// about-us one carried @id. Whatever else changes about it, it changes in one file now.
const org = organizationNode();
---
<BaseLayout
  title={page.title}
  description={page.description}
  canonical="/"
  market={market}
  schema={[org]}
>
  <Fragment slot="chrome-top">
    <UtilityBar market={market} resolvedFrom="default" />
    <SiteHeader market={market} />
  </Fragment>

  {/* SAME SECTION ORDER AS THE MARKET LANDING TEMPLATE, rendered national.
      The structure is the one the Cincinnati page uses; the content is not Cincinnati's. Copying
      that page's HTML literally would put a Milford address and a Cincinnati LocalBusiness node on
      the national URL, and leave / and /cincinnati/ as two pages with the same content competing
      for the same searches. Same shape, honest data. */}
  {/* ⚠ PLACEHOLDER HERO VIDEO. Poster is /video/hero-ground-poster.jpg — a render of the CSS
      hero_ground gradient from ui-tokens.json, so if the video is slow, blocked or fails the hero
      looks exactly as it does today. There was no existing hero still to use: the hero ground is a
      gradient, and the only image on disk was the rejected logo watermark.

      MEASURED, NOT ASSUMED. Through the existing scrim: the poster gives white 13.29:1 / accent
      6.90:1 and the video's BRIGHTEST frame gives 15.40:1 / 7.99:1 — both above the 13.6/7.1 the
      CSS ground scores, because the clip is darker than the gradient. The scrim is unchanged.

      Only this page passes media. A market hero can opt in with the same one prop. */}
  <Hero
    market={market}
    media={{ poster: "/video/hero-ground-poster.jpg", mp4: "/video/hero-placeholder.mp4", webm: "/video/hero-placeholder.webm" }}
    video={video} videoModal={true} {...page.hero} sub={heroSub} bullets={heroTrust} />
  <MarketNotice market={market} />

  {/* TRUST BAND. page.trust existed in national.js since round 7 and nothing ever rendered it, so
      the three approved claims were on the page only as prose inside other sections. The items
      come from ALWAYS_TRUE in claims.js rather than from the page data — they are the same three
      strings the hero bullets and the service-card backs use, and one array is the only way three
      surfaces stay phrased identically. "BBB accredited" and "fully insured" are deliberately not
      here: the first has no source and the second is on the pending list. */}
  <section class="trustband" aria-label="What is true on every job">
    <div class="wrap">
      <p class="trustband-h">{page.trust.heading}</p>
      <ul>
        {ALWAYS_TRUE.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>
  <BadgeRow market={market} aboveTheFold={true} />

  {/* SECTION ORDER PER THE OWNER BRIEF (2026-08-24, §4): the services block leads and the area
      finder moves to the BOTTOM, directly above the final CTA band. The earlier round argued the
      chooser belonged up here; the brief reverses that — the visitor meets what we do before
      where we are, and the selector in the utility bar still answers "do you cover me" from the
      first viewport. Logged as a reversal in DECISIONS. */}
  <WhatWeDo />
  {/* eyebrow suppressed: "Why homeowners choose us" over "Why homeowners keep calling us back" is
      the same sentence twice, and the eyebrow is accent orange, so it was also the loudest thing
      in the section competing with nothing. */}
  <WhyTrust eyebrow={null} heading={page.why.heading} cards={whyCards}
            reviews={TESTIMONIALS.national} marketSlug="national" />

  {/* DIRECTLY BELOW "Why homeowners keep calling us back", and the stacking is the point: those six
      cards say how the work runs, this says who vouches for it. One is our claim, the other is
      somebody else's — they answer different questions and neither replaces the other, so the six
      cards are untouched.

      Renders NOTHING until reviews are pulled. See ReviewsByMarket.astro for why there is no
      placeholder: the prototype's three invented testimonials are the reason this gate exists. */}
  <ReviewsByMarket />

  {/* OFFERS & PROMOTIONS replaces the standing roofing ServiceDetail block (owner brief §8) —
      the roofing depth lives on /roofing/, where round 48 put it; the homepage slot now carries
      the offer shell, which renders the evergreen free-inspection card until real offers land in
      src/data/offers.js. Reg Z gate in verify-build. */}
  <OffersSection market={market} />

  {/* THE #locations BLOCK WAS HERE AND IS GONE. It asked the same question MarketChooser asks
      directly under the badge row — "which of the three is near me" — and answering it twice on one
      page is worse than answering it once, because the second answer reads as a different question
      the reader then has to check. The chooser is higher, which is where the question is actually
      asked.

      NOTHING IS ORPHANED BY THIS. The block was one of 20 pages linking to
      /{market}/free-estimate/ — the header, footer, hero and CTA band all carry it on every market
      page. The three office addresses are unchanged in the Organization schema above and in the
      footer, so the NAP did not live here either. */}

  {/* Kept from the previous pass, as asked: the manufacturer strip. */}
  {/* swappable: the market selector in the utility bar changes these logos, the same way it
      changes the phone. See PartnerStrip.astro. */}
  <PartnerStrip {...page.partners} swappable={true} />

  <Reviews heading="Proven. Trusted. Backed by Your Neighbors." intro="Feedback from homeowners in every market we serve." reviews={TESTIMONIALS.national} />
  <FAQ items={page.faq.items} eyebrow="Common questions" heading={page.faq.heading} />

  {/* FIND YOUR AREA — moved here from under the badge row (owner brief §4): last thing before
      the final CTA, so the page closes on "which office is mine" right where the ask is made. */}
  <MarketChooser />
  <CTABand market={market} heading={page.cta.heading} body={page.cta.body} />

  <GeoRedirect markets={GEO} />

  <Fragment slot="chrome-bottom">
    <SiteFooter market={market} />
  </Fragment>
</BaseLayout>
