---
// Every page's shell. Metadata, fonts, tokens, schema, landmarks.
//
// The headline face is preloaded because it paints the H1 — the largest text on screen and part
// of the LCP candidate set. Body faces are not preloaded: swapping them costs a reflow of text
// that is already below the fold.
//
// That face is MONTSERRAT, the web display face. Saira Condensed is still self-hosted for
// render-post, but nothing in a browser paints with it, so preloading it would have been
// 12 KB spent on a file no page uses.
import "../styles/tokens.css";
import "../styles/ui-tokens.css";
import "../styles/fonts.css";
import "../styles/base.css";
import RooffulTab from "../components/RooffulTab.astro";
import MobileActionBar from "../components/MobileActionBar.astro";
import MarketPrompt from "../components/MarketPrompt.astro";
import { OG, SITE_NAME, ROBOTS_INDEXABLE, ORG_ID, LOGO, SITE, webSiteNode, webPageNode } from "../data/seo.js";

const {
  title, description, canonical,
  market, breadcrumbs = [], schema = [], ogImage = OG.image, ogImageAlt = OG.alt,
  // noindex is for pages that exist structurally but have not yet cleared site-plan's
  // uniqueness bar. Better to build the page and keep it out of the index than to ship a thin
  // duplicate and let Google decide it is one.
  noindex = false,
} = Astro.props;

const site = "https://coldstreamexteriors.com";
const canonicalUrl = new URL(canonical, site).href;

const crumbId = `${canonicalUrl}#breadcrumb`;
const crumbSchema = breadcrumbs.length > 1 ? {
  "@type": "BreadcrumbList",
  "@id": crumbId,
  itemListElement: breadcrumbs.map((c, i) => ({
    "@type": "ListItem", position: i + 1, name: c.name, item: new URL(c.href, site).href,
  })),
} : null;

// ── ONE @graph PER PAGE, NOT THREE LOOSE BLOCKS ──────────────────────────────────────────────
//
// Until round 44 a page emitted its breadcrumb, its business or service node and its FAQ as
// separate <script> tags. Every one of them was valid; NOTHING SAID THEY DESCRIBED THE SAME PAGE.
// A reader — a search crawler, an answer engine, a model asked what this company does in Columbus —
// got three unlabelled facts and had to infer the join between them.
//
// A single @graph states it instead: this URL is a WebPage, part of this WebSite, about this
// Organization, with this breadcrumb, and here is the Service or the FAQ it carries. Same facts,
// one structure, and the structure is the part a machine can follow.
//
// `@context` is hoisted to the graph, so nodes passed in by a page have theirs stripped — repeating
// it inside a graph is not wrong, it is just noise on every page.
const strip = ({ "@context": _drop, ...node }) => node;
const pageNodes = schema.map(strip);

// A REFERENCE HAS TO RESOLVE TO SOMETHING ON THE SAME PAGE.
//
// `publisher` and `about` above both point at the Organization's @id. That node is written out in
// full on / and /about-us/ and nowhere else, so on the other 73 pages those two references pointed
// at nothing a reader of THAT page could resolve. Cross-page @id resolution is not something a
// crawler is obliged to do.
//
// So every page carries the organisation — but a LEAN version of it: identity, name, URL, logo.
// NOT the addresses. Three PostalAddress nodes on all 75 pages would restate the NAP everywhere,
// which is the exact thing the location-page ruling forbids and verify-build gates. JSON-LD merges
// nodes sharing an @id, so the full node on the home page and the lean one here are one entity
// described twice, not two entities.
const hasFullOrg = pageNodes.some((n) => n["@id"] === ORG_ID);
const leanOrg = { "@type": "Organization", "@id": ORG_ID, name: SITE_NAME, url: `${SITE}/`, logo: LOGO };

const graph = {
  "@context": "https://schema.org",
  "@graph": [
    webSiteNode(),
    webPageNode({ canonical, title, description, ogImage, breadcrumbId: crumbSchema ? crumbId : null }),
    ...(hasFullOrg ? [] : [leanOrg]),
    ...(crumbSchema ? [crumbSchema] : []),
    ...pageNodes,
  ],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {/* ROBOTS. A noindexed page says only that; an indexable one asks for the largest preview
      Google will give it, because on a trade site the photograph is the argument. The two are
      mutually exclusive by construction — a page cannot ask to be kept out and shown off. */}
  <meta name="robots" content={noindex ? "noindex, follow" : ROBOTS_INDEXABLE} />

  {/* THE ICON SET. Google prints a favicon beside every result on mobile; without one the listing
      gets a generic globe while every competitor in the list shows their mark. 48px is the size
      Google's own guidance asks for and the .ico carries it; the PNGs cover the browser tab, the
      Android home screen and iOS. Generated by scripts/build-icons.mjs from the same lockup and
      the same navy the rest of the brand uses. */}
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" href="/favicon-96.png" sizes="96x96" />
  <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#1c4c78" />

  <link rel="preload" href="/fonts/montserrat-var-latin.woff2" as="font" type="font/woff2" crossorigin />

  {/* OPEN GRAPH, COMPLETE. og:image alone is not enough: without width and height the scraper
      has to fetch and measure the file before it can lay the card out, and Facebook and LinkedIn
      both render a link with no card at all on the first share while that happens. og:site_name
      is what puts the brand above the headline instead of the bare domain. */}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content={OG.locale} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={new URL(ogImage, site).href} />
  <meta property="og:image:width" content={String(OG.width)} />
  <meta property="og:image:height" content={String(OG.height)} />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, site).href} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <script type="application/ld+json" set:html={JSON.stringify(graph)} />
</head>
<body>
  <a href="#main" class="visually-hidden">Skip to content</a>
  <slot name="chrome-top" />
  <main id="main">
    {breadcrumbs.length > 1 && (
      <nav aria-label="Breadcrumb" class="wrap" style="padding-top:14px;font-size:.86rem;color:var(--cs-text-muted)">
        {breadcrumbs.map((c, i) => (
          <span>{i > 0 && " › "}{i === breadcrumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href} style="color:var(--cs-primary-deep)">{c.name}</a>}</span>
        ))}
      </nav>
    )}
    <slot />
  </main>
  {/* Right-edge instant-quote tab. PLACEMENT ONLY — no Roofful embed exists yet; see
      RooffulTab.astro. Suppressed on the estimate pages, where it would point at the page you
      are already reading. */}
  {market && !String(canonical ?? "").includes("free-estimate") && <RooffulTab market={market} />}
  {market && !String(canonical ?? "").includes("free-estimate") && <MobileActionBar market={market} />}
  {/* The scroll-triggered market prompt (audit phase 5): national pages only — a market page IS
      the answer — and never a redirect, only an offer. */}
  {market && !market.slug && <MarketPrompt />}

  <slot name="chrome-bottom" />
  {/* REVEAL ON VIEW — the script ARMS the hidden state; it does not undo it.
      base.css authors nothing as hidden. `html.cs-reveal` is what makes [data-reveal] elements
      start invisible, and this is the only place that class is ever added — after confirming
      both that motion is wanted and that IntersectionObserver exists to turn it back off again.
      The alternative, hiding in CSS and revealing with JS, means a script error or a browser
      without IO leaves finished HTML permanently invisible. Every early return below is a
      visitor who gets the full page with no animation, which is the correct failure.
      Inline and is:inline so it cannot be deferred behind a bundle: the class must land before
      first paint, or the sections flash in at full opacity and then jump to hidden. */}
  <script is:inline>
    (function () {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      if (!("IntersectionObserver" in window)) return;
      var els = document.querySelectorAll("[data-reveal]");
      if (!els.length) return;
      document.documentElement.classList.add("cs-reveal");
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          e.target.classList.add("in");
          io.unobserve(e.target);          // one-way: nothing re-hides on scroll back up
        });
      }, { threshold: 0.15, rootMargin: "0px 0px -8% 0px" });
      els.forEach(function (el) { io.observe(el); });
    })();
  </script>
</body>
</html>
