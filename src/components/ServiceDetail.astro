---
// In-page sections with anchors, NOT separate URLs. The old roof-leak / emergency / storm /
// hail / wind pages fold in here so one strong page ranks instead of a dozen thin ones
// splitting the same signal — this block is where site-plan's "fold 299" actually lands.
//
// A card may carry `service`: a REFERENCE to another hub in this market, not a URL. It resolves
// here against the market's own service list, so a card that points at a service the market does
// not offer renders as plain text instead of as a link to a page that was never built.
//
// It may also carry `requiresService: true`, which is stronger: the card DOES NOT RENDER AT ALL
// in a market that does not offer that service. That is the round-5 St. Louis ruling expressed as
// a mechanism rather than as a deletion — a card describing commercial roofing is a service claim,
// and a service claim in a market that cannot deliver it "generates leads nobody can close". One
// word in that market's services array in markets.js brings every such card back.
import { servicesFor, serviceHref } from "../data/markets.js";
const { id = "roofing", eyebrow, heading, intro, cards = [], photo, market } = Astro.props;

const offers = (key) => Boolean(market && servicesFor(market).some((s) => s.key === key));
const shown = cards.filter((c) => !(c.requiresService && !offers(c.service)));

const linkFor = (card) => {
  if (!card.service || !market) return null;
  const target = servicesFor(market).find((s) => s.key === card.service);
  return target ? { href: serviceHref(market, target), text: card.linkText ?? `See ${target.label.toLowerCase()}` } : null;
};
---
<section id={id}>
  <div class="wrap">
    <div class="shead">
      <span class="eyebrow" set:html={eyebrow} />
      <h2>{heading}</h2>
      {/* intro may be one paragraph or several — an array renders one <p> per entry. */}
      {intro && (Array.isArray(intro) ? intro : [intro]).map((para) => <p>{para}</p>)}
    </div>
    <div class="detail">
      {shown.map((c) => {
        const link = linkFor(c);
        return (
          <div class="dcard">
            <h3>{c.title}</h3>
            <p>{c.body}</p>
            {link && <a class="dlink" href={link.href}>{link.text} →</a>}
          </div>
        );
      })}
    </div>
    {photo && (
      <div style="max-width:840px;margin:22px auto 0">
        <img src={photo.src} alt={photo.alt} width={photo.w} height={photo.h}
             loading="lazy" decoding="async" style="border-radius:12px;width:100%;height:auto" />
      </div>
    )}
  </div>
</section>
