---
// Review and accreditation badges. Self-hosted, height-normalised, explicit dimensions.
//
// aboveTheFold controls loading: the hero row must not be lazy (it would delay a visible
// element), everything else is. fetchpriority is deliberately left alone — the LCP element is
// the hero poster, and competing with it would make the page slower, not faster.
import { BADGES } from "../data/badges.js";
import { CLAIMS } from "../data/claims.js";
import { NATIONAL } from "../data/markets.js";

// THE SET COMES FROM THE MARKET, NOT FROM THIS COMPONENT (team call, 2026-08-18). Pass a market and
// its `credentials` array decides which badges show and in what order; the national default is the
// company-wide set. Manufacturer programmes differ by market, so a per-market set later is a data
// edit in markets.js rather than a change here.
const { aboveTheFold = false, market = NATIONAL } = Astro.props;
const wanted = market?.credentials ?? NATIONAL.credentials;

// A badge with no asset renders as text rather than as an image. That is still gated for BBB,
// because BBB is an ACCREDITATION CLAIM and the words assert it just as loudly as a seal would —
// null CLAIMS.bbb and the slot disappears entirely, exactly as before.
//
// ── BBB: ACCREDITED AND A+, BOTH CONFIRMED (2026-08-19) ──────────────────────────────────────
//
// CLAIMS.bbb is set, so the slot renders. WHAT IT SAYS STILL DEPENDS ON WHAT IS SOURCED, and the
// two are not the same claim:
//
//     { accredited: true, rating: null }  →  "BBB Accredited Business"
//     { accredited: true, rating: "A+" }  →  "BBB A+ Accredited Business"   ← current
//
// The grade was confirmed separately from the status and later, which is why the wording is
// computed rather than written out. "BBB A+" is on verify-build's unsourced-claim list and is
// released only for the exact grade claims.js records — so if BBB ever moves the grade, a stale
// value here fails the build instead of shipping quietly. See the BBB block in verify-build.mjs.
//
// IT RENDERS AS A TYPOGRAPHIC BADGE, NOT THE DASHED "PENDING" BOX. The accreditation is real; a
// slot that looks like unfinished work misrepresents it in the other direction. The dashed style
// still exists for genuinely pending artwork. Drop BBB's hosted seal into badges.js and this
// becomes an image with no change here.
const byKey = Object.fromEntries(BADGES.map((b) => [b.key, b]));
const badges = wanted
  .map((k) => byKey[k])
  .filter(Boolean)
  .filter((b) => b.key !== "bbb" || CLAIMS.bbb);

// BBB's own wording, assembled from what is actually sourced. Kept here rather than in badges.js
// because it depends on the claim, and badges.js is artwork.
const bbbLabel = CLAIMS.bbb?.rating
  ? `BBB ${CLAIMS.bbb.rating} Accredited Business`
  : "BBB Accredited Business";
const labelFor = (b) => (b.key === "bbb" ? bbbLabel : b.pendingLabel);
const altFor = (b) => b.alt ?? labelFor(b);
const hrefFor = (b) => b.href ?? (b.key === "bbb" ? CLAIMS.bbb?.profileUrl ?? null : null);
---
<div class="logos" aria-label="Ratings and certifications">
  <div class="wrap">
    {badges.map((b) => {
      if (!b.file) {
        const text = (
          <div class={b.key === "bbb" ? "badge-text" : "badge-pending"} role="img" aria-label={altFor(b)}>
            {labelFor(b)}
          </div>
        );
        const to = hrefFor(b);
        return to ? <a class="badge" href={to} target="_blank" rel="noopener">{text}</a> : text;
      }
      const img = (
        <picture>
          <source srcset={b.file} type="image/webp" />
          <img src={b.fallback} alt={b.alt} width={b.w} height={b.h}
               loading={aboveTheFold ? "eager" : "lazy"} decoding="async" />
        </picture>
      );
      const to = hrefFor(b);
      return to
        ? <a class="badge" href={to} target="_blank" rel="noopener">{img}</a>
        : <div class="badge">{img}</div>;
    })}
  </div>
</div>
