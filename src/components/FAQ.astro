---
// Native <details>/<summary> so the accordion opens with JS disabled and is keyboard-operable
// for free. The prototype used a button + max-height transition driven by an onclick handler,
// which breaks both.
//
// On-page text and the FAQPage schema are generated from the SAME array, because Google
// requires them to match and hand-maintaining two copies is how they drift apart.
const { eyebrow = "Good to know", heading = "Common questions", items = [] } = Astro.props;
const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((i) => ({
    "@type": "Question",
    name: i.q,
    acceptedAnswer: { "@type": "Answer", text: i.a },
  })),
};
---
<section>
  <div class="wrap">
    <div class="shead"><span class="eyebrow">{eyebrow}</span><h2>{heading}</h2></div>
    <div class="faq">
      {items.map((i) => (
        <details class="q">
          <summary>{i.q}<span class="pm" aria-hidden="true">+</span></summary>
          <div class="a"><p>{i.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
{items.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
