---
// Native <details>/<summary> so the accordion opens with JS disabled and is keyboard-operable
// for free. The prototype used a button + max-height transition driven by an onclick handler,
// which breaks both.
//
// On-page text and the FAQPage schema are generated from the SAME array, because Google
// requires them to match and hand-maintaining two copies is how they drift apart.
const { eyebrow = "Good to know", heading = "Common questions", items = [] } = Astro.props;
const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((i) => ({
    "@type": "Question",
    name: i.q,
    acceptedAnswer: { "@type": "Answer", text: i.a },
  })),
};
---
<section>
  <div class="wrap">
    <div class="shead" data-reveal><span class="eyebrow">{eyebrow}</span><h2>{heading}</h2></div>
    {/* Reuses the existing stagger from base.css — the rows arrive 70ms apart as the section comes
        into view. It is opt-in per section and this is one, so no new mechanism is added. */}
    <div class="faq" data-reveal="stagger">
      {items.map((i) => (
        /* STILL NATIVE <details>/<summary>. The disclosure works with JS off, is keyboard-operable
           for free, and reports its own expanded state to assistive tech — none of which a div with
           a click handler and aria-expanded gets without being rebuilt by hand. The animation below
           is decoration layered on top of that; it does not carry the behaviour. */
        <details class="q">
          <summary>{i.q}<span class="pm" aria-hidden="true">+</span></summary>
          <div class="a"><p>{i.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
{items.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
