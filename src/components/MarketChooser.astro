---
// MARKET CHOOSER — the national page's answer to "which one of you is near me".
//
// WHY THIS EXISTS AT THE TOP OF THE PAGE. The national page shows the 844 number and cannot show
// anything else: the output is static, so there is no server to detect an area and no honest way to
// swap a phone number before the page is sent. Everything that follows from that is a choice
// between guessing and asking, and this asks.
//
// The routing that already existed was the utility bar's <select>, the footer's three offices and
// the locations section three-quarters of the way down. All of it works and none of it is visible
// at the moment a visitor is deciding whether this company covers them. This is the same three
// markets, at the top, as the first thing after the hero.
//
// EVERY NUMBER AND ADDRESS COMES FROM markets.js. `phone` is the displayed string and `telHref` is
// DERIVED from it in that file, so the two cannot disagree — which is the specific bug the live
// WordPress home page still has, printing (888) 625-5960 while linking a different number. Nothing
// here is typed.
//
// ── THE RETURNING-VISITOR HINT IS GONE (removed on instruction) ──────────────────────────────
//
// It read the stored `cs_market` cookie and offered "Looking for St. Louis?" as a dismissible line.
// Removing it also removed this component's only JavaScript — the three cards are plain links and
// the call targets are plain tel: hrefs. Recorded as a reversal in DECISIONS.md, because adding it
// was a deliberate decision two rounds earlier.
//
// ── ONE COMPONENT, TWO PLACEMENTS, BECAUSE IT IS ONE QUESTION ────────────────────────────────
//
// The national home page and the national service pages both had their own answer to "which of you
// is near me": an #locations block on the home page and an .ns-pick grid on the service pages. Two
// hand-written grids, two sets of markup, one question — and the service-page version was already
// the better idea, because it deep-linked to that market's version of the SAME service rather than
// dumping the visitor on a market landing to find it again.
//
// So that behaviour is the prop rather than a second component. Pass `service` and the cards go to
// /{market}/{service}/; leave it off and they go to /{market}/. Nothing else differs.
//
// `markets` is a prop too, because a service line does not run in every market — garage doors is
// St. Louis only — and a chooser offering a market that cannot do the job is worse than one that
// does not list it.
import { MARKET_LIST } from "../data/markets.js";
const {
  heading = "Three markets, three local crews",
  intro = "Pick the one nearest you and you will get that office, that crew and that phone number.",
  // Which markets to offer. Defaults to all three.
  markets = MARKET_LIST,
  // Optional service key. Set it and each card deep-links to that market's page for this service.
  service = null,
  // Shown when the service does not run everywhere, so the shorter list is explained rather than
  // looking like an omission.
  note = null,
} = Astro.props;

const hrefFor = (m) => (service ? `/${m.slug}/${service}/` : `/${m.slug}/`);
---
<section class="mchoose" aria-labelledby="mchoose-h">
  <div class="wrap">
    <div class="shead">
      <span class="eyebrow">Find your area</span>
      <h2 id="mchoose-h">{heading}</h2>
      <p>{intro}</p>
    </div>

    {/* THE "Looking for St. Louis?" HINT WAS HERE AND IS GONE — removed on instruction.
        It read a stored cs_market cookie and offered a one-line shortcut back to that market. It
        orphaned nothing when it went: its href was written by script at runtime, so it was never
        part of the crawlable link graph, and each market landing is linked from all 68 other pages
        by the footer's Markets list and the chooser cards below. Reversal recorded in DECISIONS.md. */}

    <ul class="mchoose-grid">
      {markets.map((m) => (
        <li>
          <a class="mchoose-card" href={hrefFor(m)} data-market={m.slug}>
            <strong>{m.name}</strong>
            <span class="mchoose-city">{m.office.city}, {m.office.state}</span>
            {/* Displayed number only — this is a link to a page, not a call link. The tel: link is
                below, so a tap on the card cannot dial by accident. */}
            <span class="mchoose-phone">{m.phone}</span>
            <span class="mchoose-go">See {m.name} <span aria-hidden="true">→</span></span>
          </a>
          <a class="mchoose-tel" href={m.telHref}>Call {m.name}</a>
        </li>
      ))}
    </ul>

    {note && <p class="mchoose-note">{note}</p>}
  </div>
</section>
{/* The inline script that drove the hint went with it. Nothing else on this component needed
    JavaScript: the three cards are plain links and the call targets are plain tel: hrefs, which is
    why removing the hint removes the script entirely rather than leaving an empty listener. */}

