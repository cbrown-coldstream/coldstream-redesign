---
// Utility bar — SECONDARY chrome. Three things and nothing else: the market selector, the phone,
// and Service Areas.
//
// ── THE DUPLICATE CTA IS GONE (2026-08-19) ───────────────────────────────────────────────────
//
// This bar used to carry "Get a Free Estimate" as a white pill, roughly 60px above the header's
// "Get Free Estimate" button. Two primary calls to action, near-identical wording, stacked — which
// splits the click rather than doubling it and makes the top of every page argue with itself.
//
// The nav's CTA is the one that survived, and the reason is scroll: the header is sticky and this
// bar is not, so past the fold the nav button is still on screen and this one never was. One
// primary action, in the place it stays reachable. /free-estimate/ is still linked from the header
// on every page, so nothing became unreachable — verified by the no-orphan-pages gate.
//
// ── WHY THIS BAR IS DARKER THAN THE PALETTE'S PRIMARY, AND IT IS NOT A TINT CHOICE ───────────
//
// The brief asked for lower-contrast text so the bar reads as secondary. Measured first: white on
// --cs-primary (#3A89C7) is 3.76:1, which ALREADY FAILS WCAG AA for 0.9rem text — lowering it
// further would have deepened a live accessibility bug rather than restyling a bar.
//
// So the recession comes from the GROUND instead of from the text. --cs-primary-deep (#2A6699)
// carries white at 6.07:1, which leaves room to pull the text back to 86% and still measure
// 4.98:1. The bar reads quieter than the white nav below it AND passes, which the original did not.
// Nothing in verify-build checks this — the contrast gate measures hero copy only — so the numbers
// are recorded here rather than left to be rediscovered.
//
// ── THE MARKET ROUTER ────────────────────────────────────────────────────────────────────────
//
// The select is the plan's market router in its simplest, host-agnostic form: a real form control,
// works with JS off, visible to every visitor, never redirects a crawler.
//
// TWO BEHAVIOURS, BECAUSE THE PAGES ARE DIFFERENT:
//
//   · ON A MARKET PAGE, choosing another market NAVIGATES to it. You are reading Cincinnati
//     content; switching to Columbus has to change the content, not just the number.
//   · ON A NATIONAL PAGE, choosing a market SWAPS THE NUMBERS IN PLACE. The page is about all
//     three markets and stays true; the visitor gets their local number without being thrown off
//     the page they chose to be on.
//
// EVERY NUMBER COMES FROM markets.js AND IS SWAPPED AS A PAIR — `phone` is the displayed string,
// `telHref` is derived from it in that file, so the two cannot disagree. The live WordPress home
// page prints (888) 625-5960 while linking a different number; that is the failure this shape
// exists to prevent. THE LABEL SWAPS WITH THEM, as a third member of the same set, so "Cincinnati"
// can never sit beside the Columbus number.
import { MARKET_LIST, NATIONAL, areasHref } from "../data/markets.js";
const { market, resolvedFrom = "default" } = Astro.props;

// slug -> { phone, telHref, label }. "" is the national default, so "Other / not sure" restores it.
// `label` is what sits in front of the number: the market name once one is chosen, "Call" when it
// is the company-wide number and naming a city would be wrong.
const PHONES = Object.fromEntries([
  ["", { phone: NATIONAL.phone, telHref: NATIONAL.telHref, label: "Call" }],
  ...MARKET_LIST.map((m) => [m.slug, { phone: m.phone, telHref: m.telHref, label: m.name }]),
]);
const here = PHONES[market.slug ?? ""];
const chosen = Boolean(market.slug);
---
<div class="util" data-resolved-from={resolvedFrom}>
  <div class="wrap">
    <div class="left">
      {/* MR. ROOF PATTERN (owner request 2026-08-25): no visible label — the pill itself reads
          "Select Your Location" until a market is chosen, with a map pin baked into the control.
          The label survives for screen readers only. */}
      <label for="mkt" class="visually-hidden">Select your location</label>
      <form method="get" action="/" id="mktForm">
        {/* `is-chosen` is what makes a selected market read as chosen rather than defaulted — see
            base.css. It is set here for the server-rendered state and maintained by the script. */}
        <select id="mkt" name="market" aria-label="Choose your market" class={chosen ? "is-chosen" : null}>
          {MARKET_LIST.map((m) => (
            <option value={m.slug} selected={market.slug === m.slug}>{m.cityState}</option>
          ))}
          {/* The empty value doubles as the placeholder, Mr. Roof style. Behavior is unchanged:
              choosing it is still the national default the router already handles. */}
          <option value="" selected={!market.slug}>Select Your Location</option>
        </select>
        <noscript><button type="submit" class="util-go">Go</button></noscript>
      </form>
    </div>

    <div class="right">
      {/* THE PHONE IS THE ACTION ON THIS BAR. It was already an <a href="tel:"> but read as a
          statement of fact: no glyph, no hover, no focus ring, and a target under 44px. It now
          announces itself as tappable. data-cs-phone marks every element whose number may be
          swapped; href, label and text are updated together, never separately. */}
      <a class="ph" href={here.telHref} data-cs-phone>
        <svg class="ph-ic" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M6.6 2.3a1.3 1.3 0 0 1 1.7.5l1.2 2.1a1.3 1.3 0 0 1-.25 1.6l-.9.8a8.6 8.6 0 0 0 3.85 3.85l.8-.9a1.3 1.3 0 0 1 1.6-.25l2.1 1.2a1.3 1.3 0 0 1 .5 1.7l-.7 1.4a2 2 0 0 1-2.2 1.05C10.4 16.2 3.8 9.6 2.85 4.7A2 2 0 0 1 3.9 2.5z"/>
        </svg>
        <span class="ph-label" data-cs-phone-label>{here.label}</span>
        <span class="ph-num" data-cs-phone-text>{here.phone}</span>
      </a>

      {/* Was a Blog link and a "Free Instant Roof Quote" link — neither page existed. Service
          Areas answers the question this bar is for: whether we come to you. */}
      <a class="areas" href={areasHref(market)}>Service Areas</a>
    </div>
  </div>
</div>
<script is:inline define:vars={{ PHONES, CURRENT: market.slug ?? "" }}>
  (function () {
    var sel = document.getElementById("mkt");
    if (!sel) return;

    function setCookie(n, v, days) {
      document.cookie = n + "=" + encodeURIComponent(v) + ";path=/;max-age=" +
        60 * 60 * 24 * days + ";samesite=lax";
    }

    sel.addEventListener("change", function () {
      var slug = sel.value;
      setCookie("cs_market", slug, 30);
      sel.classList.toggle("is-chosen", Boolean(slug));

      // On a market page the CONTENT has to change too, so navigate. "Other / not sure" goes to
      // the national page rather than nowhere.
      if (CURRENT) {
        location.href = slug ? "/" + slug + "/" : "/?national=1";
        return;
      }

      // National page: swap in place. Href, label and number together, from the map.
      var next = PHONES[slug];
      if (!next) return;
      Array.prototype.forEach.call(document.querySelectorAll("[data-cs-phone]"), function (el) {
        el.setAttribute("href", next.telHref);
        var t = el.querySelector("[data-cs-phone-text]");
        if (t) t.textContent = next.phone;
        var l = el.querySelector("[data-cs-phone-label]");
        if (l) l.textContent = next.label;
      });

      // Say what happened. A number changing silently in the corner of the screen is a change
      // nobody notices; this is also what a screen reader gets, via the live region below.
      var say = document.getElementById("mktSaid");
      if (say) {
        say.textContent = slug
          ? "Now showing the " + sel.options[sel.selectedIndex].text + " number."
          : "Showing our main number.";
      }
    });
  })();
</script>
{/* Announced politely so the swap is not silent for anyone using a screen reader. Empty until a
    choice is made, so it says nothing on load. */}
<p id="mktSaid" class="visually-hidden" role="status" aria-live="polite"></p>
