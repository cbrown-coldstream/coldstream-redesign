---
// TEMPLATE 1, SECTION 2 — the market router.
//
// This is the national home page's actual job. site-plan: "One job: take the offer, route to
// the right metro. It is not a service hub and does not compete with one."
//
// HOST-AGNOSTIC BY DESIGN. Three real links, server-rendered, always present. It works with JS
// off, for crawlers, and on any host — no edge runtime required. The client-side geo lookup in
// MarketNotice is an enhancement ON TOP of this, never a replacement: if it never runs, the
// page is still complete and every visitor can still reach their metro in one click.
import { MARKET_LIST, servicesFor } from "../data/markets.js";
const { eyebrow = "Find your market", heading, intro } = Astro.props;
---
<section id="markets">
  <div class="wrap">
    <div class="shead"><span class="eyebrow">{eyebrow}</span><h2>{heading}</h2>{intro && <p>{intro}</p>}</div>
    <div class="mkt-grid">
      {MARKET_LIST.map((m) => (
        <a class="mkt-card" href={`/${m.slug}/`}>
          <h3>{m.name}</h3>
          <p class="mkt-region">{m.region}</p>
          <address class="mkt-addr">{m.office.street}<br />{m.office.city}, {m.office.state} {m.office.zip}</address>
          <span class="mkt-phone">{m.phone}</span>
          <span class="mkt-go">See {m.name} →</span>
        </a>
      ))}
    </div>
  </div>
</section>
<style>
  .mkt-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .mkt-card{display:block;background:var(--cs-paper);border:1px solid var(--cs-line);border-top:4px solid var(--cs-primary);border-radius:12px;padding:24px;text-decoration:none;transition:transform .12s,box-shadow .12s,border-color .12s}
  .mkt-card:hover{transform:translateY(-3px);box-shadow:0 14px 30px color-mix(in srgb, var(--cs-text) 10%, transparent);border-top-color:var(--cs-accent)}
  .mkt-card h3{font-size:1.3rem;margin-bottom:4px}
  .mkt-region{font-size:.9rem;color:var(--cs-text-muted);margin:0 0 10px}
  .mkt-addr{font-style:normal;font-size:.92rem;color:var(--cs-text-muted);line-height:1.5;margin-bottom:10px}
  .mkt-phone{display:block;font-family:var(--cs-web-display);font-weight:var(--cs-web-display-weight);font-size:1.1rem;color:var(--cs-text);margin-bottom:12px}
  .mkt-go{font-family:var(--cs-web-display);font-weight:var(--cs-web-display-weight);font-size:.92rem;color:var(--cs-primary)}
  .mkt-card:hover .mkt-go{color:var(--cs-accent)}
  @media(max-width:860px){.mkt-grid{grid-template-columns:1fr}}
</style>
