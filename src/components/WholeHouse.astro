---
// ONE TEAM, YOUR WHOLE EXTERIOR — the strongest thing this company can say plainly, drawn rather
// than listed.
//
// The brief asked for a house with the four systems called out, and said a photo beats an
// illustration where a photo exists. NO SUCH PHOTO EXISTS in this repo — the only image is the
// hero poster — and a stock house with callouts stuck on it would be a photograph of somebody
// else's home pretending to be our work. So this is an authored diagram in the brand palette: it
// claims nothing it cannot back, and it does the one job a list of four cards cannot, which is to
// show that the four systems are parts of a single building.
//
// Inline SVG rather than an image file: it is a handful of shapes, it scales without a second
// asset, and it takes brand tokens directly so it can never drift from the palette.
//
// The callouts are real links to the service hubs. On a national page there is no single market to
// point at, so they scroll to the services section above, which carries the market routing.
import { MARKETS } from "../data/markets.js";
const { eyebrow, heading, intro } = Astro.props;

const parts = [
  { key: "roofing", label: "Roofing", note: "Tear-off, replacement, storm and leak repair." },
  { key: "siding",  label: "Siding",  note: "Fiber cement and vinyl, and the flashing behind it." },
  { key: "windows", label: "Windows", note: "Full-frame and insert replacement." },
  { key: "gutters", label: "Gutters", note: "Seamless runs, guards, and where the water goes." },
];
---
<section class="whole reveal">
  <div class="wrap">
    <div class="shead">
      <span class="eyebrow">{eyebrow}</span>
      <h2>{heading}</h2>
      {intro && <p>{intro}</p>}
    </div>

    <div class="whole-grid">
      <div class="house-fig">
        {/* Decorative: every part of it is named in the list beside it, so a screen reader gets
            the content without having to parse a drawing. */}
        <svg viewBox="0 0 420 300" role="img" aria-label="A house with its roof, siding, windows and gutters marked">
          <defs>
            <linearGradient id="skyg" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--cs-cloud)" />
              <stop offset="100%" stop-color="var(--cs-paper)" />
            </linearGradient>
          </defs>
          <rect x="0" y="0" width="420" height="300" fill="url(#skyg)" />

          {/* body */}
          <rect x="96" y="140" width="228" height="126" fill="var(--cs-mist)" stroke="var(--cs-steel)" stroke-width="2" />
          {/* siding courses */}
          {[152, 164, 176, 188, 200, 212, 224, 236, 248, 260].map((y) => (
            <line x1="98" y1={y} x2="322" y2={y} stroke="var(--cs-steel)" stroke-width="1" opacity="0.45" />
          ))}
          {/* roof */}
          <path d="M84 144 L210 66 L336 144 Z" fill="var(--cs-primary-deep)" />
          <path d="M84 144 L210 66 L336 144 Z" fill="none" stroke="var(--cs-deep-dark)" stroke-width="2" />
          {/* roof courses */}
          {[0, 1, 2, 3].map((i) => (
            <line x1={96 + i * 9} y1={136 - i * 18} x2={324 - i * 9} y2={136 - i * 18}
                  stroke="var(--cs-deep-dark)" stroke-width="1" opacity="0.28" />
          ))}
          {/* gutter along the eave */}
          <rect x="80" y="140" width="260" height="9" rx="3" fill="var(--cs-accent)" />
          {/* downspout */}
          <rect x="326" y="149" width="8" height="117" rx="3" fill="var(--cs-accent)" opacity="0.85" />
          {/* windows */}
          <rect x="128" y="168" width="46" height="52" fill="var(--cs-paper)" stroke="var(--cs-deep-dark)" stroke-width="2" />
          <line x1="151" y1="168" x2="151" y2="220" stroke="var(--cs-deep-dark)" stroke-width="1.5" />
          <rect x="246" y="168" width="46" height="52" fill="var(--cs-paper)" stroke="var(--cs-deep-dark)" stroke-width="2" />
          <line x1="269" y1="168" x2="269" y2="220" stroke="var(--cs-deep-dark)" stroke-width="1.5" />
          {/* door */}
          <rect x="192" y="200" width="38" height="66" fill="var(--cs-primary)" stroke="var(--cs-deep-dark)" stroke-width="2" />
          {/* ground */}
          <line x1="40" y1="266" x2="380" y2="266" stroke="var(--cs-steel)" stroke-width="2" />

          {/* markers, numbered to match the list */}
          <g font-family="var(--cs-web-display)" font-weight="800" font-size="15" text-anchor="middle">
            <circle cx="210" cy="104" r="15" fill="var(--cs-accent)" />
            <text x="210" y="110" fill="var(--cs-paper)">1</text>
            <circle cx="120" cy="240" r="15" fill="var(--cs-accent)" />
            <text x="120" y="246" fill="var(--cs-paper)">2</text>
            <circle cx="269" cy="194" r="15" fill="var(--cs-accent)" />
            <text x="269" y="200" fill="var(--cs-paper)">3</text>
            <circle cx="352" cy="150" r="15" fill="var(--cs-accent)" />
            <text x="352" y="156" fill="var(--cs-paper)">4</text>
          </g>
        </svg>
      </div>

      <ol class="parts">
        {parts.map((p, i) => (
          <li>
            <span class="pnum" aria-hidden="true">{i + 1}</span>
            <div>
              <h3>{p.label}</h3>
              <p>{p.note}</p>
            </div>
          </li>
        ))}
        <li class="parts-foot">
          <p>
            One crew, one schedule, one number to call. Doing them together is faster and cheaper
            than booking four separate trades — and it means nobody can blame the last contractor
            for what the water is doing now.
          </p>
        </li>
      </ol>
    </div>
  </div>
</section>
<style>
  .whole{background:var(--cs-paper)}
  .whole-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:44px;align-items:center}
  @media(max-width:900px){.whole-grid{grid-template-columns:1fr;gap:28px}}

  .house-fig{background:var(--cs-paper);border:1px solid var(--cs-line);border-radius:14px;padding:16px}
  .house-fig svg{width:100%;height:auto;display:block;border-radius:8px}

  .parts{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:18px}
  .parts li{display:flex;gap:15px;align-items:flex-start}
  .pnum{flex:none;width:32px;height:32px;border-radius:50%;background:var(--cs-accent);color:var(--cs-paper);
    display:grid;place-items:center;font-family:var(--cs-web-display);font-weight:var(--cs-web-display-weight);font-size:.95rem}
  .parts h3{font-size:1.14rem;margin:0 0 3px}
  .parts p{margin:0;color:var(--cs-text-muted);font-size:.95rem;line-height:1.55}
  .parts-foot{border-top:1px solid var(--cs-line);padding-top:16px}
  .parts-foot p{font-size:.97rem}
</style>
