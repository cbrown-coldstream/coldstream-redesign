---
// REVIEWS — rebuilt to the owner brief (2026-08-24, §7): top nine pulled reviews, a 3-up
// carousel, and a deep-navy band so the section has the presence the old flat grid lacked.
//
// ── THE GATE IS UNCHANGED AND IS THE POINT ───────────────────────────────────────────────────
//
// Nothing renders without real pulled data. The prototype shipped three invented testimonials
// under "Real feedback from Cincinnati homeowners"; that is why this section's empty state is
// ABSENCE, not sample copy — not even during development. Source order: the GBP pull at
// src/data/generated/reviews.json (top nine across the markets, newest first, exactly as pulled
// — nothing here sorts by rating or drops a low one); the legacy `reviews` prop stays as the
// fallback input so market pages keep working the day TESTIMONIALS fills instead.
//
// ── DESIGN DECISIONS THAT NEED THEIR REASONS KEPT ────────────────────────────────────────────
//
// · THE CITY LABEL IS GONE from each card (brief). The pull keeps `market` on the record for
//   attribution elsewhere; the card shows name + date only.
// · STAR GLYPHS ARE ACCENT ORANGE — a deliberate second use of a colour that is otherwise
//   emphasis-only. Review stars are conventionally warm and read as an icon, not as headline
//   emphasis; the alternative tried on paper was light-blue stars, which read as INACTIVE
//   (empty) stars. Logged in DECISIONS as an exception.
// · A review's star count is its own: a real four-star review renders four stars. No fallback
//   to five, ever.
//
// ── HOW THE CAROUSEL DEGRADES ────────────────────────────────────────────────────────────────
//
// The markup is a plain 3-up grid. JS, when present, turns it into a paged carousel: previous /
// next buttons (real <button>s, visible focus), arrow-key support on the group, pause-on-hover
// for the auto-advance, and prefers-reduced-motion disables auto-advance entirely. With JS off
// the buttons never render and the first page stands as a static grid — which is the brief's
// no-JS fallback, by construction rather than by a second code path.
import { readFileSync, existsSync } from "node:fs";
import { resolve } from "node:path";

const { eyebrow = "Reviews", heading, intro, reviews = [] } = Astro.props;

const PULLED = resolve(process.cwd(), "src/data/generated/reviews.json");
let pulled = [];
if (existsSync(PULLED)) {
  try {
    const j = JSON.parse(readFileSync(PULLED, "utf8"));
    pulled = Object.values(j.markets ?? {}).flatMap((m) => m.reviews ?? []);
    pulled.sort((a, b) => String(b.date ?? "").localeCompare(String(a.date ?? "")));
  } catch { pulled = []; }
}
const items = (pulled.length ? pulled : reviews).slice(0, 9);
const stars = (n) => (Number.isFinite(n) && n >= 1 && n <= 5 ? "★".repeat(Math.round(n)) : null);
---
{items.length > 0 && (
<section id="reviews" class="revband">
  <div class="wrap">
    <div class="shead" data-reveal>
      <span class="eyebrow">{eyebrow}</span>
      <h2>{heading}</h2>
      {intro && <p>{intro}</p>}
    </div>

    <div class="rev-shell" data-rev-carousel data-count={items.length}>
      <div class="rev-track" id="revTrack" tabindex="-1">
        {items.map((r) => (
          <figure class="rev-card">
            {stars(r.rating) && (
              <div class="rev-stars" aria-label={`${r.rating} out of 5 stars`}>{stars(r.rating)}</div>
            )}
            <blockquote><p>{r.quote}</p></blockquote>
            <figcaption>
              <span class="rev-name">{r.name}</span>
              {r.date && <span class="rev-date">{r.date}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
      {/* Controls are injected by the script so a no-JS page never shows dead buttons. */}
    </div>
  </div>

  <script is:inline>
    (function () {
      var shell = document.querySelector("[data-rev-carousel]");
      if (!shell) return;
      var track = shell.querySelector(".rev-track");
      var cards = track.children.length;
      var perPage = 3, page = 0, pages = Math.ceil(cards / perPage);
      if (pages < 2) return;                       // nothing to control

      var nav = document.createElement("div");
      nav.className = "rev-nav";
      nav.innerHTML =
        '<button type="button" class="rev-btn" data-dir="-1" aria-label="Previous reviews">←</button>' +
        '<span class="rev-pos" aria-live="polite"></span>' +
        '<button type="button" class="rev-btn" data-dir="1" aria-label="Next reviews">→</button>';
      shell.appendChild(nav);
      var pos = nav.querySelector(".rev-pos");

      function go(n) {
        page = (n + pages) % pages;
        track.style.transform = "translateX(-" + page * 100 + "%)";
        pos.textContent = (page + 1) + " / " + pages;
      }
      nav.addEventListener("click", function (e) {
        var b = e.target.closest("[data-dir]");
        if (b) go(page + Number(b.dataset.dir));
      });
      shell.addEventListener("keydown", function (e) {
        if (e.key === "ArrowRight") { e.preventDefault(); go(page + 1); }
        if (e.key === "ArrowLeft")  { e.preventDefault(); go(page - 1); }
      });

      shell.classList.add("is-carousel");
      go(0);

      // Auto-advance: only when motion is welcome, and paused whenever a pointer or focus is in.
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        var timer = setInterval(function () { go(page + 1); }, 7000);
        function hold() { clearInterval(timer); timer = null; }
        function resume() { if (!timer) timer = setInterval(function () { go(page + 1); }, 7000); }
        shell.addEventListener("mouseenter", hold);
        shell.addEventListener("mouseleave", resume);
        shell.addEventListener("focusin", hold);
        shell.addEventListener("focusout", resume);
      }
    })();
  </script>
</section>
)}

<style>
  /* The deep navy band — --cs-web-hero-base ground, white elevated cards, accent name rule. */
  .revband { background: var(--cs-web-hero-base, #101922); }
  /* Eyebrow stays ACCENT ORANGE on the navy band — the "bolder" ask of 2026-08-25. It is the
     section's one loud element besides the stars; the name rule and controls stay sky so orange
     remains an icon-and-eyebrow colour rather than the section's voice. */
  .revband .shead .eyebrow { color: var(--cs-accent); }
  .revband .shead h2 { color: #fff; }
  .revband .shead p { color: var(--cs-web-hero-sub, #c8d8e7); }

  .rev-shell { position: relative; overflow: hidden; }
  .rev-track {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px;
    transition: transform .35s ease-out;
  }
  /* Carousel mode: pages of three, side by side.
     ⚠ template-columns MUST be cleared here. Left in place, the base rule's three 1fr tracks
     fight the auto-flow columns: the implicit columns overflow the container, the free space
     goes negative, and the three template tracks collapse to min-content — page one renders as
     three squeezed slivers next to full-width implicit cards. Seen on screen, not deduced. */
  .rev-shell.is-carousel .rev-track {
    display: grid; grid-template-columns: none;
    grid-auto-flow: column; grid-auto-columns: calc((100% - 36px) / 3);
  }
  @media (max-width: 760px) {
    .rev-track { grid-template-columns: 1fr; }
    .rev-shell.is-carousel .rev-track { grid-template-columns: none; grid-auto-columns: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .rev-track { transition: none; } }

  .rev-card {
    margin: 0; position: relative; background: var(--cs-paper); border-radius: 12px;
    padding: 26px 24px 20px; display: flex; flex-direction: column; gap: 12px;
    border-top: 4px solid var(--cs-accent);
    box-shadow: 0 14px 34px rgba(0, 0, 0, .45);
  }
  /* Oversized quote glyph in the hero accent — decoration, so it is aria-free markup-free:
     a pseudo-element that never enters the accessibility tree. */
  .rev-card::before {
    content: "\201C"; position: absolute; top: 2px; right: 16px;
    font-family: var(--cs-web-display); font-weight: 900; font-size: 4.4rem; line-height: 1;
    color: var(--cs-web-hero-accent, #8fc0ea); opacity: .38; pointer-events: none;
  }
  /* Orange stars — the logged exception. Conventionally warm; light blue read as inactive. */
  .rev-stars { color: var(--cs-accent); letter-spacing: 2.5px; font-size: 1.28rem; }
  .rev-card blockquote { margin: 0; flex: 1; }
  .rev-card blockquote p { margin: 0; font-size: .96rem; line-height: 1.6; color: var(--cs-text); }
  .rev-card figcaption {
    border-top: 2px solid var(--cs-web-hero-accent, #8fc0ea);
    padding-top: 10px; display: flex; justify-content: space-between; gap: 10px; align-items: baseline;
  }
  .rev-name { font-family: var(--cs-web-display); font-weight: var(--cs-web-display-weight-strong); font-size: 1.02rem; }
  .rev-date { font-size: .8rem; color: var(--cs-text-muted); }

  /* ⚠ :global(), NECESSARILY. The nav is injected by the inline script, and runtime-created
     nodes never receive Astro's scoping attribute — scoped selectors simply do not match them.
     The controls rendered as bare default buttons until this was seen on screen. */
  .rev-shell :global(.rev-nav) { display: flex; align-items: center; justify-content: center; gap: 16px; margin-top: 26px; }
  .rev-shell :global(.rev-btn) {
    width: 44px; height: 44px; border-radius: 50%; cursor: pointer;
    background: transparent; color: var(--cs-web-hero-accent, #8fc0ea);
    border: 2px solid var(--cs-web-hero-accent, #8fc0ea); font-size: 1.1rem; line-height: 1;
  }
  .rev-shell :global(.rev-btn:hover) { background: color-mix(in srgb, var(--cs-web-hero-accent, #8fc0ea) 18%, transparent); }
  .rev-shell :global(.rev-btn:focus-visible) { outline: 3px solid var(--cs-ui-focus); outline-offset: 2px; }
  .rev-shell :global(.rev-pos) { color: var(--cs-web-hero-sub, #c8d8e7); font-size: .9rem; font-variant-numeric: tabular-nums; }
</style>
