---
// REVIEWS — rebuilt to the owner brief (2026-08-24, §7): top nine pulled reviews, a 3-up
// carousel, and a deep-navy band so the section has the presence the old flat grid lacked.
//
// ── THE GATE IS UNCHANGED AND IS THE POINT ───────────────────────────────────────────────────
//
// Nothing renders without real pulled data. The prototype shipped three invented testimonials
// under "Real feedback from Cincinnati homeowners"; that is why this section's empty state is
// ABSENCE, not sample copy — not even during development. Source order: the GBP pull at
// src/data/generated/reviews.json (top nine across the markets, newest first, exactly as pulled
// — nothing here sorts by rating or drops a low one); the legacy `reviews` prop stays as the
// fallback input so market pages keep working the day TESTIMONIALS fills instead.
//
// ── DESIGN DECISIONS THAT NEED THEIR REASONS KEPT ────────────────────────────────────────────
//
// · THE CITY LABEL IS GONE from each card (brief). The pull keeps `market` on the record for
//   attribution elsewhere; the card shows name + date only.
// · STAR GLYPHS ARE ACCENT ORANGE — a deliberate second use of a color that is otherwise
//   emphasis-only. Review stars are conventionally warm and read as an icon, not as headline
//   emphasis; the alternative tried on paper was light-blue stars, which read as INACTIVE
//   (empty) stars. Logged in DECISIONS as an exception.
// · A review's star count is its own: a real four-star review renders four stars. No fallback
//   to five, ever.
//
// ── THE MARQUEE, AND HOW IT DEGRADES (owner, 2026-08-26: "rotating across screen, vibrant") ──
//
// The paged 3-up carousel of 08-25 lasted a day; the owner wants continuous rotation. This is
// now the same mechanism as the partner strip: two identical server-rendered runs, the second
// aria-hidden, animating -100% on a loop — NO JavaScript at all. Hover or keyboard focus pauses
// it. prefers-reduced-motion kills the animation, hides the duplicate run, and lays the first
// out as a static grid — which is also exactly what a no-JS visitor always got, because there
// was never any JS to lose.
import { readFileSync, existsSync } from "node:fs";
import { resolve } from "node:path";

const { eyebrow = "Reviews", heading, intro, reviews = [] } = Astro.props;

const PULLED = resolve(process.cwd(), "src/data/generated/reviews.json");
let pulled = [];
if (existsSync(PULLED)) {
  try {
    const j = JSON.parse(readFileSync(PULLED, "utf8"));
    pulled = Object.values(j.markets ?? {}).flatMap((m) => m.reviews ?? []);
    pulled.sort((a, b) => String(b.date ?? "").localeCompare(String(a.date ?? "")));
  } catch { pulled = []; }
}
// ── PLACEHOLDER MODE (owner instruction, 2026-08-27, third reaffirmation) ────────────────────
// The owner wants the carousel VISIBLE now, with nine placeholder reviews, real ones to follow.
// The no-invented-reviews rule was raised each time and the owner's decision stands — shipped
// with the one guardrail that keeps it a placeholder rather than a fabricated endorsement:
// every card carries a visible "Sample" tag and self-describing copy. No invented names, no
// aggregate figure. Real pulled reviews REPLACE these automatically (pulled wins below), and
// the tag logic keys off the sample flag, so nothing real ever gets tagged.
const PLACEHOLDERS = Array.from({ length: 9 }, (_, i) => ({
  sample: true,
  rating: 5,
  name: "Your customer",
  date: null,
  quote: [
    "This is a sample review. When the Google review feed connects, your real customer reviews rotate through here — names, stars and dates straight from Google.",
    "Sample review card. Real reviews from your local Google Business Profiles will fill this carousel.",
    "A shorter sample card, to show how varied review lengths sit side by side.",
  ][i % 3],
}));
const usePlaceholders = Astro.props.placeholders === true && !pulled.length && !reviews.length;
const items = (pulled.length ? pulled : reviews.length ? reviews : usePlaceholders ? PLACEHOLDERS : []).slice(0, 9);

// The Mr. Roof-style aggregate header — Google mark, overall stars, total count — renders ONLY
// from the pull's own per-market figures (rating and userRatingCount straight off each Google
// listing). No pull, no header: an aggregate is a factual claim about real profiles, gated the
// same as everything else in this section.
let agg = null;
if (existsSync(PULLED)) {
  try {
    const j = JSON.parse(readFileSync(PULLED, "utf8"));
    const ms = Object.values(j.markets ?? {}).filter((m) => m.rating && m.count);
    if (ms.length) {
      const count = ms.reduce((n, m) => n + m.count, 0);
      const rating = ms.reduce((n, m) => n + m.rating * m.count, 0) / count;
      agg = { rating: Math.round(rating * 10) / 10, count };
    }
  } catch {}
}
const stars = (n) => (Number.isFinite(n) && n >= 1 && n <= 5 ? "★".repeat(Math.round(n)) : null);
---
{items.length > 0 && (
<section id="reviews" class="revband">
  <div class="wrap">
    <div class="shead" data-reveal>
      <span class="eyebrow">{eyebrow}</span>
      <h2>{heading}</h2>
      {intro && <p>{intro}</p>}
      {agg && (
        <p class="rev-agg">
          <span class="rev-g" aria-hidden="true">G</span>
          <span class="rev-agg-stars" aria-hidden="true">{"★".repeat(Math.round(agg.rating))}</span>
          <strong>{agg.rating}</strong> on Google · {agg.count.toLocaleString("en-US")} reviews
        </p>
      )}
    </div>

    <div class="rev-marquee" tabindex="0" aria-label="Customer reviews — rotating; focus or hover to pause">
      <ul class="rev-run">
        {items.map((r) => (
          <li class="rev-card">
            {r.sample && <span class="rev-sample">Sample</span>}
            {stars(r.rating) && (
              <div class="rev-stars" aria-label={r.sample ? "Sample star row" : `${r.rating} out of 5 stars`}>{stars(r.rating)}</div>
            )}
            <blockquote><p>{r.quote}</p></blockquote>
            <figcaption>
              <span class="rev-name">{r.name}</span>
              {r.date && <span class="rev-date">{r.date}</span>}
            </figcaption>
          </li>
        ))}
      </ul>
      <ul class="rev-run" aria-hidden="true">
        {items.map((r) => (
          <li class="rev-card">
            {stars(r.rating) && <div class="rev-stars">{stars(r.rating)}</div>}
            <blockquote><p>{r.quote}</p></blockquote>
            <figcaption>
              <span class="rev-name">{r.name}</span>
              {r.date && <span class="rev-date">{r.date}</span>}
            </figcaption>
          </li>
        ))}
      </ul>
    </div>
  </div>


</section>
)}

<style>
  /* THE VIBRANT BAND (owner ask): the hero's own gradient rather than flat navy, an orange
     eyebrow, and cards that glow slightly against it. Loud is allowed here — this is the one
     section whose whole job is social proof, and it was invisible-by-gate for months. */
  .revband { background: var(--cs-web-hero-ground, linear-gradient(135deg, #2f80c4 0%, #256199 55%, #1c4c78 100%)); position: relative; overflow: hidden; }
  .revband::before { content: ""; position: absolute; inset: 0; background: var(--cs-web-hero-scrim); pointer-events: none; }
  .revband .wrap { position: relative; }
  .revband .shead .eyebrow { color: var(--cs-accent); }
  .revband .shead h2 { color: #fff; font-size: clamp(1.6rem, 3.6vw, 2.1rem); }
  .revband .shead p { color: var(--cs-web-hero-sub, #c8d8e7); }

  /* The marquee: two identical runs, second aria-hidden, sliding -100%. Same mechanism as the
     partner strip, so the site has one rotation idiom, not two. */
  /* The aggregate line: the Google mark, the overall stars, the real count — Mr. Roof's own
     pattern. Renders only from pulled figures. */
  .rev-agg {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    margin: 14px 0 4px; color: #fff; font-size: 1.05rem;
  }
  .rev-agg strong { font-family: var(--cs-web-display); font-size: 1.2rem; }
  .rev-agg-stars { color: var(--cs-accent); letter-spacing: 2px; font-size: 1.25rem; }
  .rev-g {
    width: 30px; height: 30px; border-radius: 50%; background: #fff; color: #4285F4;
    font-family: var(--cs-web-display); font-weight: 900; font-size: 1.1rem;
    display: grid; place-items: center;
  }

  .rev-marquee {
    display: flex; overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 4%, #000 96%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 4%, #000 96%, transparent 100%);
  }
  .rev-marquee:focus-visible { outline: 3px solid var(--cs-accent); outline-offset: 4px; }
  .rev-run {
    list-style: none; margin: 0; padding: 6px 0 14px; flex: none; min-width: 100%;
    display: flex; gap: 18px; padding-right: 18px;
    animation: revslide 60s linear infinite;
  }
  .rev-marquee:hover .rev-run, .rev-marquee:focus-within .rev-run, .rev-marquee:focus .rev-run { animation-play-state: paused; }
  @keyframes revslide { 0% { transform: translateX(0); } 100% { transform: translateX(-100%); } }

  .rev-card {
    flex: none; width: clamp(280px, 30vw, 380px);
    position: relative; background: var(--cs-paper); border-radius: 14px;
    padding: 26px 24px 20px; display: flex; flex-direction: column; gap: 12px;
    border-top: 5px solid var(--cs-accent);
    box-shadow: 0 16px 38px rgba(11, 20, 30, .38);
  }
  .rev-card::before {
    content: "\201C"; position: absolute; top: 2px; right: 16px;
    font-family: var(--cs-web-display); font-weight: 900; font-size: 4.4rem; line-height: 1;
    color: var(--cs-web-hero-accent, #8fc0ea); opacity: .4; pointer-events: none;
  }
  .rev-sample {
    position: absolute; top: 10px; left: 14px;
    font-family: var(--cs-web-display); font-weight: 800; font-size: .62rem;
    letter-spacing: .12em; text-transform: uppercase;
    color: var(--cs-text-muted); border: 1px dashed var(--cs-text-muted);
    border-radius: 4px; padding: 2px 7px; opacity: .85;
  }
  .rev-stars { color: var(--cs-accent); letter-spacing: 2.5px; font-size: 1.3rem; }
  .rev-card:has(.rev-sample) .rev-stars { color: var(--cs-text-muted); opacity: .55; }
  .rev-card blockquote { margin: 0; flex: 1; }
  .rev-card blockquote p { margin: 0; font-size: .96rem; line-height: 1.6; color: var(--cs-text); }
  .rev-card figcaption {
    border-top: 2px solid var(--cs-web-hero-accent, #8fc0ea);
    padding-top: 10px; display: flex; justify-content: space-between; gap: 10px; align-items: baseline;
  }
  .rev-name { font-family: var(--cs-web-display); font-weight: var(--cs-web-display-weight-strong); font-size: 1.02rem; }
  .rev-date { font-size: .8rem; color: var(--cs-text-muted); }

  /* Reduced motion: no slide, no duplicate, a plain grid. */
  @media (prefers-reduced-motion: reduce) {
    .rev-run { animation: none; flex-wrap: wrap; }
    .rev-run[aria-hidden="true"] { display: none; }
    .rev-marquee { -webkit-mask-image: none; mask-image: none; }
    .rev-card { width: min(100%, 380px); }
  }
</style>
