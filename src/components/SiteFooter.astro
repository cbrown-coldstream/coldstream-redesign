---
// Footer NAP must match the Google Business Profile EXACTLY for this market — real office
// address, not virtual. Consistent NAP across site + GBP + citations is a direct local-ranking
// factor, which is why the address comes from the market config and is never retyped.
import { MARKET_LIST, servicesFor, serviceHref, estimateHref, aboutHref } from "../data/markets.js";
import { marketsWithGallery } from "../data/locations.js";
import { marketsWithReviews, gbpFor } from "../data/claims.js";
const { market } = Astro.props;
// servicesFor, NOT homeownerServicesFor — the footer is where the commercial hub gets its
// site-wide link, so it is reachable from every page rather than orphaned.
const services = servicesFor(market);
const o = market.office;
// THE FOOTER ADDRESS NOW LINKS TO THE OFFICE'S GOOGLE LISTING, which is what the `mapUrl` slot in
// markets.js was reserved for since round 1 and could not be filled until 2026-08-24.
//
// It is the human half of the same statement the schema makes. The header comment above says the
// footer NAP must match the Google Business Profile exactly — this makes that checkable by anyone
// reading the page rather than only by whoever compares two tabs, and it hands a visitor the route
// to directions and reviews in one click.
//
// Null on the national footer, and null for any market without a listing. Nothing renders then.
const gbp = market.slug ? gbpFor(market.slug) : null;
const year = 2026;

// Reviews and Gallery are in the plan's page system and are BUILT — as templates gated on real
// proof, so a market has those pages only once real reviews and real job photos exist for it.
// Asking the same question here that getStaticPaths asks means the link and the page can never
// disagree: the day the GBP pull and the Contractors Cloud pull land, these appear by themselves.
const extras = market.slug
  ? [
      marketsWithReviews().includes(market.slug) && { href: `/${market.slug}/reviews/`, label: "Reviews" },
      marketsWithGallery().includes(market.slug) && { href: `/${market.slug}/gallery/`, label: "Our Work" },
    ].filter(Boolean)
  : [];
---
<footer>
  <div class="wrap">
    <div class="cols">
      <div>
        <a class="brand" href="/"><img src="/logo-coldstream-exteriors.jpg" alt="Coldstream Exteriors" width="240" height="70" /></a>
        {o ? (
          <address class="addr" style="font-style:normal">
            <strong style="color:var(--cs-paper)">{o.label}</strong><br />
            {o.street}<br />{o.city}, {o.state} {o.zip}<br />
            <a href={market.telHref}>{market.phone}</a>
            {gbp && (
              <a class="gmaps" href={gbp} target="_blank" rel="noopener">
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                  <path fill="currentColor" d="M8 1.2a4.4 4.4 0 0 0-4.4 4.4c0 3.3 4.4 9.2 4.4 9.2s4.4-5.9 4.4-9.2A4.4 4.4 0 0 0 8 1.2m0 6.2a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6"/>
                </svg>
                View on Google Maps
              </a>
            )}
          </address>
        ) : (
          <address class="addr" style="font-style:normal">
            <strong style="color:var(--cs-paper)">Ohio &amp; Missouri</strong><br />
            <a href={market.telHref}>{market.phone}</a>
          </address>
        )}
      </div>
      {/* THESE ARE h2, NOT h4. They were h4 and every page in the build jumped h2 → h4 at the
          footer — a heading level skipped is a screen reader announcing a subsection of something
          that was never opened, and it is the one structural fault an outline check finds on all
          75 pages at once. The footer is a landmark of the document, so its column titles sit at
          the same level as a page section. Only the selector in base.css changed with them. */}
      <div>
        <h2>Services</h2>
        {services.map((s) => <a href={serviceHref(market, s)}>{s.label}</a>)}
      </div>
      <div>
        <h2>Company</h2>
        {extras.map((e) => <a href={e.href}>{e.label}</a>)}
        <a href={aboutHref(market)}>About</a>
        {market.slug && <a href="/about-us/">The Company</a>}
        <a href="/blog/">Advice</a>
        <a href="/financing/">Financing</a>
        <a href={estimateHref(market)}>Free Estimate</a>
      </div>
      <div>
        <h2>Markets</h2>
        {MARKET_LIST.map((m) => <a href={`/${m.slug}/`}>{m.name}</a>)}
      </div>
    </div>
    <div class="bot">
      <span>© {year} Coldstream Exteriors. Licensed &amp; insured.</span>
      <span><a href="/privacy-policy/" style="display:inline">Privacy</a> · <a href="/terms/" style="display:inline">Terms</a> · <a href="/sitemap/" style="display:inline">Sitemap</a></span>
    </div>
  </div>
</footer>
