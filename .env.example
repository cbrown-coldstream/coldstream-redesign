# Copy to .env and fill in. .env IS GITIGNORED AND MUST STAY THAT WAY — this repo is public.
# Nothing in this file is a real value; it is the list of what the scripts need.

# ── GOOGLE PLACES (npm run reviews:pull) ─────────────────────────────────────────────────────
#
# A Places API (New) key with Place Details enabled. RESTRICT IT: in the Cloud console, limit the
# key to the Places API and nothing else. It is only ever used from a terminal by a person running
# the pull, never shipped to a browser — the site is static and a key in public HTML is a billable
# key anyone can lift.
GOOGLE_PLACES_API_KEY=

# The three offices' Place IDs. Find one at https://developers.google.com/maps/documentation/places/web-service/place-id
#
# PLACE IDS ARE THE ONE THING GOOGLE'S POLICY LETS YOU STORE INDEFINITELY — "the place ID ... is
# exempt from the caching restrictions" — which is why they live here as configuration while the
# review text they return does not live anywhere permanent. See scripts/pull-reviews.mjs.
GOOGLE_PLACE_ID_CINCINNATI=
GOOGLE_PLACE_ID_COLUMBUS=
GOOGLE_PLACE_ID_ST_LOUIS=

# ── SUPABASE (npm run review:sync) ───────────────────────────────────────────────────────────
#
# The service-role key for the review board's database. It BYPASSES row-level security, so it is
# the one credential that could read or rewrite the whole board. Terminal only, never committed,
# never in a page. The anon key is public by design and lives in src/data/review-db.js.
SUPABASE_SERVICE_KEY=
# Optional — defaults to the review board project if unset.
SUPABASE_PROJECT_REF=
