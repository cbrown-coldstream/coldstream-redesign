node_modules
dist
.astro

# Generated into public/ by the postbuild step so the NEXT build carries them.
# They are build output, not source — regenerate with `npm run build`.
public/handoff

# The handoff zip is a build artefact of dist/, rebuilt on demand.
handoff/*.zip

# Local Netlify folder
.netlify

# Real credentials. .env.example is the committed template; .env itself never is — this repo is
# public, and a Places key or a Supabase service-role key in it would be a billable key anyone
# can lift.
.env
.env.local

# macOS writes these into any folder Finder opens. One of them had already been staged.
.DS_Store

# Working files for assets that DID ship: raw exports, contact sheets, logo dumps. Kept because
# throwing away the high-resolution source of a badge is how you end up unable to resize it later,
# and ignored because none of it belongs in a deploy — the two preview sheets alone were 233 KB
# of public/ that nothing linked to.
_assets-source/
rambow-handoff-kit/

# installed skill packs (ui-ux-pro-max etc.) are local tooling for Claude Code sessions,
# not part of the build or the deploy. See CLAUDE.md "Installed skills" for what is in scope.
.claude/
