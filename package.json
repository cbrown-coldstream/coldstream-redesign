{
  "name": "coldstream-exteriors-site",
  "type": "module",
  "private": true,
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "redirects": "node scripts/build-redirects.mjs",
    "dev": "npm run tokens && astro dev",
    "build": "npm run tokens && npm run redirects && npm run og && npm run icons && npm run lastmod && npm run llms && astro build",
    "preview": "astro preview",
    "verify": "node scripts/verify-build.mjs",
    "contracts": "node scripts/check-contracts.mjs",
    "similarity": "node scripts/check-similarity.mjs",
    "review:sync": "node scripts/sync-review-board.mjs",
    "test:gates": "node scripts/test-gates.mjs",
    "briefs": "node scripts/build-briefs.mjs",
    "handoff": "node scripts/handoff.mjs",
    "inventory": "node scripts/page-inventory.mjs",
    "pagemap": "node scripts/build-pagemap.mjs",
    "review": "node scripts/build-review-wall.mjs",
    "live:pull": "node scripts/pull-live-copy.mjs",
    "reviews:pull": "node scripts/pull-reviews.mjs",
    "handoff:site": "node scripts/build-handoff.mjs",
    "brand:publish": "node scripts/brand-publish.mjs",
    "pages": "node scripts/build-pages-md.mjs",
    "postbuild": "node scripts/build-pagemap.mjs && node scripts/build-handoff.mjs && node scripts/build-pages-md.mjs && node scripts/build-review-wall.mjs",
    "og": "node scripts/build-og-image.mjs",
    "icons": "node scripts/build-icons.mjs",
    "lastmod": "node scripts/build-lastmod.mjs",
    "llms": "node scripts/build-llms-txt.mjs"
  },
  "devDependencies": {
    "astro": "^4.16.18"
  }
}
